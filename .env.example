# Doppler REST API is the primary secret source when DOPPLER_TOKEN is set;
# this file is the per-key local fallback when Doppler is unavailable.
TRYPOST_BASE_URL=your-trypost-base-url
TRYPOST_API_KEY=your-trypost-api-key

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id

# Optional Google OAuth (shared across GCP/Google APIs) + Drive archive root folder
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id
