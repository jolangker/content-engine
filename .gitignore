# Local settings and secrets
/.commandcode/
.env
.env.*
!.env.example

# Track editorial records and one composite storyboard per production.
/productions/**
!/productions/*/
!/productions/*/EPISODE.md
!/productions/*/CONTRACT.json
!/productions/*/SOURCES.md
!/productions/*/SCRIPT.md
!/productions/*/CONTENT_PACKAGE.md
!/productions/*/exports/
!/productions/*/exports/thumbnail.png
!/productions/*/exports/cover.png
!/productions/*/exports/*-cover.png
!/productions/*/video/
!/productions/*/video/STORYBOARD.md
!/productions/*/video/REVIEW.md
!/productions/*/video/boards/
!/productions/*/video/boards/storyboard.png

# Dependencies and interpreter caches
**/node_modules/
**/__pycache__/
*.py[cod]
/.venv/

# OS files and runtime logs
.DS_Store
Thumbs.db
*.log

# Render outputs and generated media packages (keep production thumbnails tracked above)
**/exports/*
!/productions/*/exports/thumbnail.png
!/productions/*/exports/cover.png
!/productions/*/exports/*-cover.png
**/tts-packages/
**/.thumbnails/
**/.waveform-cache/

# HyperFrames generated previews, reports, and session history.
# Keep other project metadata eligible for tracking.
**/.hyperframes/preview/
**/.hyperframes/artifacts/
**/.hyperframes/history-turns.json
**/.hyperframes/hf-ids-stamped.json
**/.hyperframes/history-id
**/.hyperframes/video-state.json

# Board audio binaries belong in asset storage.
# Board manifests, credits, and licenses stay tracked.
/boards/**/assets/audio/**/*.wav
/boards/**/assets/audio/**/*.mp3
/boards/**/assets/audio/**/*.m4a
/boards/**/assets/audio/**/*.aac
/boards/**/assets/audio/**/*.flac
/boards/**/assets/audio/**/*.ogg
/boards/**/assets/audio/**/*.aiff

# Keep source images, fonts, board drafts, and revision documents until
# their asset-storage or Git-history replacements are in place.

/references/
