[
  {
    "start": 0.362037,
    "end": 1.467037,
    "text": "Ditarik pelan,"
  },
  {
    "start": 1.633333,
    "end": 3.096667,
    "text": "sabuk ini memanjang."
  },
  {
    "start": 3.188889,
    "end": 5.096667,
    "text": "Disentak, malah mengunci."
  },
  {
    "start": 5.188889,
    "end": 5.966667,
    "text": "Apa yang berubah di"
  },
  {
    "start": 5.966667,
    "end": 6.578148,
    "text": "dalamnya?"
  },
  {
    "start": 6.880556,
    "end": 7.966667,
    "text": "Pita itu terhubung ke"
  },
  {
    "start": 7.966667,
    "end": 8.652222,
    "text": "gulungan."
  },
  {
    "start": 8.818519,
    "end": 10.448148,
    "text": "Saat ditarik, gulungannya ikut"
  },
  {
    "start": 10.448148,
    "end": 11.244815000000001,
    "text": "berputar."
  },
  {
    "start": 11.337037,
    "end": 12.559259,
    "text": "Pegas di sisi gulungan"
  },
  {
    "start": 12.559259,
    "end": 13.92963,
    "text": "menarik pita kembali saat"
  },
  {
    "start": 13.92963,
    "end": 15.133704000000002,
    "text": "tidak lagi ditahan."
  },
  {
    "start": 15.262963,
    "end": 17.133703999999998,
    "text": "Sekarang buka sisi penguncinya."
  },
  {
    "start": 17.262963,
    "end": 18.374074,
    "text": "Kita lihat satu desain"
  },
  {
    "start": 18.374074,
    "end": 20.281852,
    "text": "dengan roda inersia bergigi."
  },
  {
    "start": 20.374074,
    "end": 21.837407,
    "text": "Roda penggerak menempel pada"
  },
  {
    "start": 21.855556,
    "end": 22.911481,
    "text": "poros gulungan."
  },
  {
    "start": 22.966667,
    "end": 24.522222,
    "text": "Giginya memutar roda kecil"
  },
  {
    "start": 24.522222,
    "end": 25.485185,
    "text": "yang terhubung ke roda"
  },
  {
    "start": 25.485185,
    "end": 26.392962999999998,
    "text": "inersia."
  },
  {
    "start": 26.522222,
    "end": 28.133703999999998,
    "text": "Saat tarikan normal, roda"
  },
  {
    "start": 28.151852,
    "end": 29.467036999999998,
    "text": "inersia ikut berputar."
  },
  {
    "start": 29.707407,
    "end": 31.040741,
    "text": "Pelat pembawanya tetap di"
  },
  {
    "start": 31.040741,
    "end": 31.541110999999997,
    "text": "tempat."
  },
  {
    "start": 31.781481,
    "end": 33.170741,
    "text": "Pegas kecil menahan pelat"
  },
  {
    "start": 33.188889,
    "end": 35.003704,
    "text": "itu, sehingga pengunci masih"
  },
  {
    "start": 35.003704,
    "end": 36.578148000000006,
    "text": "berjarak dari gigi gulungan."
  },
  {
    "start": 36.892593,
    "end": 38.892593,
    "text": "Lalu, tarikan mendadak mempercepat"
  },
  {
    "start": 38.892593,
    "end": 39.467037000000005,
    "text": "gulungan."
  },
  {
    "start": 39.707407,
    "end": 41.374074,
    "text": "Tetapi roda inersia menolak"
  },
  {
    "start": 41.374074,
    "end": 43.059630000000006,
    "text": "perubahan putaran yang tiba-tiba."
  },
  {
    "start": 43.114815,
    "end": 44.837407000000006,
    "text": "Hambatan inilah pemicunya."
  },
  {
    "start": 44.892593,
    "end": 46.497222,
    "text": "Dorongan antargigi kini bisa"
  },
  {
    "start": 46.497222,
    "end": 48.151852,
    "text": "mengalahkan tarikan pegas penahan"
  },
  {
    "start": 48.151852,
    "end": 48.652222,
    "text": "pelat."
  },
  {
    "start": 48.892593,
    "end": 50.151852,
    "text": "Roda kecil tidak cuma"
  },
  {
    "start": 50.151852,
    "end": 51.059630000000006,
    "text": "berputar."
  },
  {
    "start": 51.114815,
    "end": 51.763333,
    "text": "Porosnya"
  },
  {
    "start": 51.818519,
    "end": 53.485185,
    "text": "bergerak mengitari roda penggerak,"
  },
  {
    "start": 53.485185,
    "end": 54.837407000000006,
    "text": "sambil membawa pelat."
  },
  {
    "start": 54.892593,
    "end": 56.188889,
    "text": "Pelat yang bergeser membawa"
  },
  {
    "start": 56.188889,
    "end": 56.726296000000005,
    "text": "lengan."
  },
  {
    "start": 56.966667,
    "end": 58.3,
    "text": "Ujung lengan itu mendorong"
  },
  {
    "start": 58.3,
    "end": 59.652222,
    "text": "bagian belakang pengunci."
  },
  {
    "start": 59.707407,
    "end": 61.188889,
    "text": "Pengunci berayun masuk ke"
  },
  {
    "start": 61.188889,
    "end": 62.485185,
    "text": "roda bergigi yang menyatu"
  },
  {
    "start": 62.485185,
    "end": 63.43,
    "text": "dengan gulungan."
  },
  {
    "start": 63.485185,
    "end": 65.05963,
    "text": "Perhatikan titik pertemuannya."
  },
  {
    "start": 65.188889,
    "end": 67.225926,
    "text": "Begitu giginya tertahan, gulungan"
  },
  {
    "start": 67.225926,
    "end": 68.50407399999999,
    "text": "berhenti melepas pita."
  },
  {
    "start": 68.67037,
    "end": 70.077778,
    "text": "Tarikan kini diteruskan ke"
  },
  {
    "start": 70.077778,
    "end": 71.50407399999999,
    "text": "rangka lewat pengunci."
  },
  {
    "start": 71.559259,
    "end": 73.411111,
    "text": "Jadi, roda inersia memicu"
  },
  {
    "start": 73.411111,
    "end": 74.133704,
    "text": "gerakan."
  },
  {
    "start": 74.151852,
    "end": 75.707407,
    "text": "Pengunci dan roda bergigilah"
  },
  {
    "start": 75.707407,
    "end": 76.80037,
    "text": "yang menahan gulungan."
  },
  {
    "start": 77.040741,
    "end": 78.022593,
    "text": "Bandingkan lagi."
  },
  {
    "start": 78.077778,
    "end": 79.94851899999999,
    "text": "Tarikan halus memutar roda."
  },
  {
    "start": 80.003704,
    "end": 81.92963,
    "text": "Sentakan menggerakkan pelat, lalu"
  },
  {
    "start": 81.92963,
    "end": 82.80037,
    "text": "pengunci masuk."
  },
  {
    "start": 83.025926,
    "end": 84.374074,
    "text": "Di desain ini, perubahan"
  },
  {
    "start": 84.374074,
    "end": 86.318889,
    "text": "gerak pita memicu penguncian."
  },
  {
    "start": 86.374074,
    "end": 87.92963,
    "text": "Sensor gerak kendaraan memakai"
  },
  {
    "start": 87.92963,
    "end": 88.80037,
    "text": "jalur lain."
  }
]
