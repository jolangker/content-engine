[
  {
    "start": 0.335,
    "end": 1.535,
    "text": "Sekali klik, isi pensil"
  },
  {
    "start": 1.535,
    "end": 2.1115957400000003,
    "text": "maju."
  },
  {
    "start": 2.18180851,
    "end": 3.60946809,
    "text": "Kenapa saat tombol kembali,"
  },
  {
    "start": 3.61159574,
    "end": 4.835,
    "text": "isinya tidak ikut mundur?"
  },
  {
    "start": 5.49264583,
    "end": 6.81312583,
    "text": "Pada mekanisme tekan ini,"
  },
  {
    "start": 6.81312583,
    "end": 7.88208583,
    "text": "isi dibawa oleh penjepit"
  },
  {
    "start": 7.88208583,
    "end": 8.73096583,
    "text": "kecil di dekat ujung"
  },
  {
    "start": 8.73096583,
    "end": 9.52264583,
    "text": "pensil."
  },
  {
    "start": 10.15529167,
    "end": 11.31764461,
    "text": "Kepala penjepit bercelah dan"
  },
  {
    "start": 11.31764461,
    "end": 12.09254657,
    "text": "melebar."
  },
  {
    "start": 12.09254657,
    "end": 13.25489951,
    "text": "Cincin di luarnya merapatkan"
  },
  {
    "start": 13.25489951,
    "end": 15.19529167,
    "text": "rahang, sehingga isi tergenggam."
  },
  {
    "start": 15.7879375,
    "end": 17.14062716,
    "text": "Saat tombol ditekan, tabung"
  },
  {
    "start": 17.14062716,
    "end": 18.20345474,
    "text": "isi dan penjepit bergerak"
  },
  {
    "start": 18.20345474,
    "end": 18.85805991,
    "text": "ke depan."
  },
  {
    "start": 18.85805991,
    "end": 19.71717888,
    "text": "Pegas di dalam ikut"
  },
  {
    "start": 19.71717888,
    "end": 20.5579375,
    "text": "tertekan."
  },
  {
    "start": 21.17058333,
    "end": 22.95445617,
    "text": "Selama masih menjepit, rahang,"
  },
  {
    "start": 22.95445617,
    "end": 24.34191281,
    "text": "cincin, dan isi bergerak"
  },
  {
    "start": 24.34191281,
    "end": 25.06867582,
    "text": "bersama."
  },
  {
    "start": 25.06867582,
    "end": 26.22488969,
    "text": "Isi melewati penahan ringan"
  },
  {
    "start": 26.22488969,
    "end": 26.98558333,
    "text": "di ujung."
  },
  {
    "start": 27.62352083,
    "end": 29.04712624,
    "text": "Lalu cincin menyentuh pembatas"
  },
  {
    "start": 29.04712624,
    "end": 30.14718496,
    "text": "di rumah mekanisme."
  },
  {
    "start": 30.14718496,
    "end": 31.92669171,
    "text": "Cincin berhenti, tetapi penjepit"
  },
  {
    "start": 31.92669171,
    "end": 33.23352083,
    "text": "masih bisa maju sedikit."
  },
  {
    "start": 34.02822917,
    "end": 35.08239583,
    "text": "Perhatikan celah ini."
  },
  {
    "start": 35.08239583,
    "end": 36.30489583,
    "text": "Kepala penjepit keluar dari"
  },
  {
    "start": 36.30489583,
    "end": 38.1715625,
    "text": "cincin, rahangnya membuka, dan"
  },
  {
    "start": 38.1715625,
    "end": 40.03822917,
    "text": "genggamannya pada isi terlepas."
  },
  {
    "start": 40.7429375,
    "end": 41.77988406,
    "text": "Isi tidak langsung meluncur"
  },
  {
    "start": 41.77988406,
    "end": 42.44984876,
    "text": "bebas."
  },
  {
    "start": 42.44984876,
    "end": 43.33530391,
    "text": "Penahan di dekat ujung"
  },
  {
    "start": 43.33530391,
    "end": 45.0879375,
    "text": "memegangnya dengan gesekan ringan."
  },
  {
    "start": 45.66058333,
    "end": 47.0883979,
    "text": "Ketika tombol dilepas, pegas"
  },
  {
    "start": 47.0883979,
    "end": 48.71091446,
    "text": "mengembalikan tabung dan penjepit."
  },
  {
    "start": 48.71091446,
    "end": 49.68442439,
    "text": "Isi tetap di posisi"
  },
  {
    "start": 49.68442439,
    "end": 50.66058333,
    "text": "yang sudah maju."
  },
  {
    "start": 51.18822917,
    "end": 52.2993006,
    "text": "Selagi rahang belum menggenggam"
  },
  {
    "start": 52.2993006,
    "end": 53.96590774,
    "text": "lagi, penjepit bergeser kembali"
  },
  {
    "start": 53.96590774,
    "end": 55.10965774,
    "text": "melewati isi yang ditahan"
  },
  {
    "start": 55.10965774,
    "end": 55.863229170000004,
    "text": "di ujung."
  },
  {
    "start": 56.410875,
    "end": 57.49863095,
    "text": "Saat kepala penjepit masuk"
  },
  {
    "start": 57.49863095,
    "end": 58.76889087,
    "text": "kembali ke cincin, rahangnya"
  },
  {
    "start": 58.76889087,
    "end": 59.96714484,
    "text": "merapat dan menggenggam isi"
  },
  {
    "start": 59.99635119,
    "end": 60.580875,
    "text": "lagi."
  },
  {
    "start": 61.26558333,
    "end": 62.64797597,
    "text": "Sekarang isi tertahan oleh"
  },
  {
    "start": 62.64797597,
    "end": 63.65761631,
    "text": "penjepit utama."
  },
  {
    "start": 63.65761631,
    "end": 64.45825204,
    "text": "Penahan ringan di ujung"
  },
  {
    "start": 64.45825204,
    "end": 65.9064729,
    "text": "tadi membantu selama perpindahan"
  },
  {
    "start": 65.9064729,
    "end": 66.73058332999999,
    "text": "genggaman."
  },
  {
    "start": 67.37675,
    "end": 68.54753261,
    "text": "Jadi, gerak maju dan"
  },
  {
    "start": 68.54753261,
    "end": 69.7833587,
    "text": "gerak kembali tidak membawa"
  },
  {
    "start": 69.7833587,
    "end": 70.5313587,
    "text": "isi dengan cara yang"
  },
  {
    "start": 70.5313587,
    "end": 71.21674999999999,
    "text": "sama."
  },
  {
    "start": 71.80439583,
    "end": 73.20374224,
    "text": "Klik berikutnya mengulangi urutan"
  },
  {
    "start": 73.36361152,
    "end": 75.05276185,
    "text": "itu: jepit, bawa maju,"
  },
  {
    "start": 75.05276185,
    "end": 76.87439583,
    "text": "lepas, lalu jepit kembali."
  },
  {
    "start": 77.43704167,
    "end": 78.68697877,
    "text": "Ini contoh mekanisme rahang"
  },
  {
    "start": 78.68697877,
    "end": 79.51999607,
    "text": "dan cincin."
  },
  {
    "start": 79.51999607,
    "end": 80.85792217,
    "text": "Jarak geraknya diperbesar agar"
  },
  {
    "start": 80.85792217,
    "end": 82.07496619,
    "text": "perpindahan genggaman terlihat"
  },
  {
    "start": 82.07496619,
    "end": 82.76704167,
    "text": "jelas."
  },
  {
    "start": 83.43997917,
    "end": 85.08604658,
    "text": "Tombolnya kembali, tetapi isi"
  },
  {
    "start": 85.08604658,
    "end": 86.33705782,
    "text": "sudah berpindah pegangan."
  },
  {
    "start": 86.33705782,
    "end": 87.65391175,
    "text": "Itulah sebabnya setiap klik"
  },
  {
    "start": 87.65391175,
    "end": 88.77323759,
    "text": "meninggalkan sedikit isi di"
  },
  {
    "start": 88.77323759,
    "end": 89.39997917,
    "text": "luar."
  }
]
