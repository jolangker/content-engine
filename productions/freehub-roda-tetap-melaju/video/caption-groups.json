[
  {
    "start": 0.29,
    "end": 1.29654083,
    "text": "Pedalnya berhenti."
  },
  {
    "start": 1.37658866,
    "end": 3.025,
    "text": "Kenapa rodanya masih berputar?"
  },
  {
    "start": 3.67745833,
    "end": 5.01722927,
    "text": "Di roda belakang, penggerak"
  },
  {
    "start": 5.01722927,
    "end": 5.93391465,
    "text": "dari rantai dan rumah"
  },
  {
    "start": 5.93391465,
    "end": 7.70245833,
    "text": "roda bisa berputar berbeda."
  },
  {
    "start": 8.33991667,
    "end": 9.92514394,
    "text": "Saat mengayuh, rantai menarik"
  },
  {
    "start": 9.92514394,
    "end": 10.66491667,
    "text": "sproket."
  },
  {
    "start": 10.66491667,
    "end": 12.10923485,
    "text": "Sproket memutar badan penggerak"
  },
  {
    "start": 12.10923485,
    "end": 13.08991667,
    "text": "di dalam freehub."
  },
  {
    "start": 13.697375,
    "end": 14.75195444,
    "text": "Di sinilah pengait kecil"
  },
  {
    "start": 14.75195444,
    "end": 16.04466472,
    "text": "bertemu cincin bergigi yang"
  },
  {
    "start": 16.04466472,
    "end": 17.437375000000003,
    "text": "terhubung ke rumah roda."
  },
  {
    "start": 18.09483333,
    "end": 19.38717568,
    "text": "Pegas mendorong ujung pengait"
  },
  {
    "start": 19.38717568,
    "end": 20.30541892,
    "text": "ke arah gigi."
  },
  {
    "start": 20.30541892,
    "end": 21.96983333,
    "text": "Bagian ini disebut pawl."
  },
  {
    "start": 22.69254167,
    "end": 23.93952737,
    "text": "Ketika penggerak berputar untuk"
  },
  {
    "start": 23.93952737,
    "end": 25.69483294,
    "text": "mengayuh, ujung pengait mendekati"
  },
  {
    "start": 25.69483294,
    "end": 26.972541670000002,
    "text": "sisi gigi yang tegak."
  },
  {
    "start": 27.747,
    "end": 28.93455396,
    "text": "Lihat titik sentuhnya."
  },
  {
    "start": 28.93455396,
    "end": 30.01732374,
    "text": "Pengait tertahan di sisi"
  },
  {
    "start": 30.01732374,
    "end": 31.62401439,
    "text": "itu, lalu mendorong cincin"
  },
  {
    "start": 31.62401439,
    "end": 32.702,
    "text": "ikut berputar."
  },
  {
    "start": 33.47645833,
    "end": 34.62221833,
    "text": "Putaran diteruskan ke rumah"
  },
  {
    "start": 34.62221833,
    "end": 36.01101833,
    "text": "roda dan jari-jari."
  },
  {
    "start": 36.01101833,
    "end": 37.05261833,
    "text": "Roda pun didorong oleh"
  },
  {
    "start": 37.05261833,
    "end": 37.916458330000005,
    "text": "kayuhan."
  },
  {
    "start": 38.55391667,
    "end": 39.96002354,
    "text": "Sekarang kayuhan berhenti."
  },
  {
    "start": 39.96002354,
    "end": 41.571588420000005,
    "text": "Penggerak dari rantai melambat,"
  },
  {
    "start": 41.57704644,
    "end": 43.258916670000005,
    "text": "tetapi roda masih melaju."
  },
  {
    "start": 43.851375,
    "end": 44.97251786,
    "text": "Cincin pada rumah roda"
  },
  {
    "start": 44.97251786,
    "end": 46.61919643,
    "text": "kini bergerak melewati pengait."
  },
  {
    "start": 46.61919643,
    "end": 47.98558929,
    "text": "Kontaknya datang dari sisi"
  },
  {
    "start": 47.98558929,
    "end": 48.856375,
    "text": "sebaliknya."
  },
  {
    "start": 49.44383333,
    "end": 50.78698402,
    "text": "Sisi miring gigi menekan"
  },
  {
    "start": 50.78698402,
    "end": 51.70631621,
    "text": "pengait masuk."
  },
  {
    "start": 51.70631621,
    "end": 53.47328539,
    "text": "Pengait berputar pada dudukannya,"
  },
  {
    "start": 53.47328539,
    "end": 54.84383333,
    "text": "melawan dorongan pegas."
  },
  {
    "start": 55.56829167,
    "end": 57.03382012,
    "text": "Setelah puncak gigi lewat,"
  },
  {
    "start": 57.041625,
    "end": 58.29934858,
    "text": "pegas mengangkat ujung pengait"
  },
  {
    "start": 58.29934858,
    "end": 60.088291670000004,
    "text": "lagi menuju celah berikutnya."
  },
  {
    "start": 60.78925,
    "end": 62.97396698,
    "text": "Tekan, lepas, lalu berulang."
  },
  {
    "start": 63.16151415,
    "end": 64.23981604,
    "text": "Kontak pengait dan gigi"
  },
  {
    "start": 64.23981604,
    "end": 65.5337783,
    "text": "inilah sumber klik pada"
  },
  {
    "start": 65.5337783,
    "end": 66.60425,
    "text": "freehub tipe ini."
  },
  {
    "start": 67.19170833,
    "end": 68.60578879,
    "text": "Bantalan menopang bagian yang"
  },
  {
    "start": 68.60578879,
    "end": 69.30119108999999,
    "text": "berputar."
  },
  {
    "start": 69.35004167,
    "end": 70.98739799,
    "text": "Pengait mengatur sambungan satu"
  },
  {
    "start": 70.98739799,
    "end": 72.6991796,
    "text": "arahnya, sehingga roda tidak"
  },
  {
    "start": 72.6991796,
    "end": 73.76670833,
    "text": "harus menyeret pedal."
  },
  {
    "start": 74.37416667,
    "end": 76.01531609,
    "text": "Saat mengayuh lagi, penggerak"
  },
  {
    "start": 76.01531609,
    "end": 76.56290229999999,
    "text": "menyusul."
  },
  {
    "start": 76.7612931,
    "end": 78.14135057,
    "text": "Setelah ujung pengait bertemu"
  },
  {
    "start": 78.14135057,
    "end": 79.96899425,
    "text": "sisi penahan berikutnya, putaran"
  },
  {
    "start": 79.96899425,
    "end": 80.96416667,
    "text": "tersambung kembali."
  },
  {
    "start": 81.646875,
    "end": 83.40463443,
    "text": "Jadi, saat meluncur, gigi"
  },
  {
    "start": 83.40463443,
    "end": 84.48081368,
    "text": "melewati pengait."
  },
  {
    "start": 84.48081368,
    "end": 86.33857311,
    "text": "Saat mengayuh, pengait menahannya."
  },
  {
    "start": 86.52555425,
    "end": 88.03220519,
    "text": "Roda bisa melaju sementara"
  },
  {
    "start": 88.03220519,
    "end": 89.35187499999999,
    "text": "pedal beristirahat."
  }
]
