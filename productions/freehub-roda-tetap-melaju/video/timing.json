      "start": 33.03333333333333,
      "end": 38.2,
      "duration": 5.166666666666671,
      "title": "Sekarang keduanya ikut berputar",
      "text": "Putaran diteruskan ke rumah roda dan jari-jari. Roda pun didorong oleh kayuhan.",
      "view": "ring",
      "job": "Coordinated rotation, output spokes share ring motion.",
      "word_start": 78,
      "word_end": 90,
      "speech_start": 33.47645833333333,
      "speech_end": 37.81645833333334,
      "timestamp_anchor_scale": 0.9361850602409633,
      "start_frame": 991,
