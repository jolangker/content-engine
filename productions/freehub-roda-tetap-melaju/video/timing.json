      "id": "s01-mystery",
      "key": "mystery",
      "start": 0,
      "end": 3.3,
      "duration": 3.3,
      "title": "Pedal berhenti. Roda tetap jalan.",
      "text": "Pedalnya berhenti. Kenapa rodanya masih berputar?",
      "view": "bike",
      "job": "Opening proof: stationary crank, moving rear wheel.",
      "word_start": 0,
      "word_end": 6,
      "speech_start": 0.29,
      "speech_end": 2.925,
      "timestamp_anchor_scale": 0.9709567343511386,
      "start_frame": 0,
      "end_frame": 99
    },
    {
      "id": "s02-independent",
      "key": "independent",
      "start": 3.3,
      "end": 7.966666666666667,
      "duration": 4.666666666666667,
      "title": "Dua bagian, bisa beda putaran",
      "text": "Di roda belakang, penggerak dari rantai dan rumah roda bisa berputar berbeda.",
      "view": "ring",
      "job": "First discovery: input stops while output rotates; introduce separation at functional use.",
      "word_start": 6,
      "word_end": 18,
      "speech_start": 3.6774583333333335,
      "speech_end": 7.602458333333334,
      "timestamp_anchor_scale": 0.9506681565696877,
      "start_frame": 99,
      "end_frame": 239
    },
    {
      "id": "s03-input",
      "key": "input",
      "start": 7.966666666666667,
      "end": 13.333333333333334,
      "duration": 5.366666666666667,
      "title": "Rantai memutar penggerak",
      "text": "Saat mengayuh, rantai menarik sproket. Sproket memutar badan penggerak di dalam freehub.",
      "view": "axial",
      "job": "Chain travel drives sprocket and splined input body.",
      "word_start": 18,
      "word_end": 30,
      "speech_start": 8.339916666666667,
      "speech_end": 12.989916666666666,
      "timestamp_anchor_scale": 0.9498630887185103,
      "start_frame": 239,
      "end_frame": 400
    },
    {
      "id": "s04-inside",
      "key": "inside",
      "start": 13.333333333333334,
      "end": 17.7,
      "duration": 4.366666666666665,
      "title": "Pengait bertemu cincin bergigi",
      "text": "Di sinilah pengait kecil bertemu cincin bergigi yang terhubung ke rumah roda.",
      "view": "ring",
      "job": "Cut shell at the shared axle; ring belongs to output, pawls to input.",
      "word_start": 30,
      "word_end": 42,
      "speech_start": 13.697375,
      "speech_end": 17.337375,
      "timestamp_anchor_scale": 0.9172750816349509,
      "start_frame": 400,
      "end_frame": 531
    },
    {
      "id": "s05-spring",
      "key": "spring",
      "start": 17.7,
      "end": 22.266666666666666,
      "duration": 4.566666666666666,
      "title": "Pegas menyiapkan pengait",
      "text": "Pegas mendorong ujung pengait ke arah gigi. Bagian ini disebut pawl.",
      "view": "macro",
      "job": "First use of spring and pivot; pawl is biased outward.",
      "word_start": 42,
      "word_end": 53,
      "speech_start": 18.094833333333334,
      "speech_end": 21.869833333333332,
      "timestamp_anchor_scale": 0.9170140019537606,
      "start_frame": 531,
      "end_frame": 668
    },
    {
      "id": "s06-approach",
      "key": "approach",
      "start": 22.266666666666666,
      "end": 27.3,
      "duration": 5.033333333333335,
      "title": "Menuju sisi yang menahan",
      "text": "Ketika penggerak berputar untuk mengayuh, ujung pengait mendekati sisi gigi yang tegak.",
      "view": "macro",
      "job": "Approach: a small angular clearance closes at a steep tooth face.",
      "word_start": 53,
      "word_end": 65,
      "speech_start": 22.692541666666667,
      "speech_end": 26.872541666666667,
      "timestamp_anchor_scale": 0.9339872853751865,
      "start_frame": 668,
      "end_frame": 819
    },
    {
      "id": "s07-contact",
      "key": "contact",
      "start": 27.3,
      "end": 33.03333333333333,
      "duration": 5.733333333333331,
      "title": "Kontak ini meneruskan putaran",
      "text": "Lihat titik sentuhnya. Pengait tertahan di sisi itu, lalu mendorong cincin ikut berputar.",
      "view": "macro",
      "job": "Signature: approach, metal contact, coupled input/output and result hold.",
      "word_start": 65,
      "word_end": 78,
      "speech_start": 27.747,
      "speech_end": 32.602,
      "timestamp_anchor_scale": 0.9417950940452463,
