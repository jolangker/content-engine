[
  {
    "text": "Sekali tekan, air keluar.",
    "start": 0.38,
    "end": 2.48,
    "scene": "s01"
  },
  {
    "text": "Tapi siapa yang tahu kapan tangkinya sudah penuh?",
    "start": 2.62,
    "end": 5.52,
    "scene": "s01"
  },
  {
    "text": "Kita buka tangki tipe tuas dan flapper.",
    "start": 5.916875,
    "end": 8.584875,
    "scene": "s02"
  },
  {
    "text": "Ada dua katup dengan tugas berbeda.",
    "start": 8.564875,
    "end": 10.904874999999999,
    "scene": "s02"
  },
  {
    "text": "Yang di bawah membuang air.",
    "start": 11.168125,
    "end": 13.028125,
    "scene": "s03"
  },
  {
    "text": "Yang di samping mengatur air masuk.",
    "start": 13.008125,
    "end": 15.348125,
    "scene": "s03"
  },
  {
    "text": "Tekan gagang.",
    "start": 15.725583,
    "end": 16.718583000000002,
    "scene": "s04"
  },
  {
    "text": "Tuas berputar, menarik rantai ke atas.",
    "start": 16.658583,
    "end": 19.518583000000003,
    "scene": "s04"
  },
  {
    "text": "Rantai mengangkat flapper dari dudukannya.",
    "start": 19.977854,
    "end": 22.597854,
    "scene": "s05"
  },
  {
    "text": "Jalur menuju mangkuk terbuka.",
    "start": 22.537854,
    "end": 24.597854,
    "scene": "s05"
  },
  {
    "text": "Air tangki turun karena gravitasi.",
    "start": 25.514792,
    "end": 27.894792000000002,
    "scene": "s06"
  },
  {
    "text": "Gagangnya tidak memompa air.",
    "start": 27.874792,
    "end": 29.974792,
    "scene": "s06"
  },
  {
    "text": "Gagang dilepas.",
    "start": 30.528479,
    "end": 31.868479,
    "scene": "s07"
  },
  {
    "text": "Daya apung membantu flapper tetap terbuka sesaat.",
    "start": 31.848479,
    "end": 34.988479,
    "scene": "s07"
  },
  {
    "text": "Air turun, pelampung ikut merosot.",
    "start": 35.774,
    "end": 38.434000000000005,
    "scene": "s08"
  },
  {
    "text": "Katup pengisi mulai membuka.",
    "start": 38.414,
    "end": 40.354,
    "scene": "s08"
  },
  {
    "text": "Jadi, pengisian bisa dimulai saat air lama masih keluar.",
    "start": 41.042104,
    "end": 44.502104,
    "scene": "s09"
  },
  {
    "text": "Saat tangki terkuras, flapper turun.",
    "start": 45.179771,
    "end": 47.759771,
    "scene": "s10"
  },
  {
    "text": "Karet bertemu dudukan, menutup jalur buang.",
    "start": 47.699771,
    "end": 50.719771,
    "scene": "s10"
  },
  {
    "text": "Kini air masuk tertampung.",
    "start": 51.698333,
    "end": 53.758333,
    "scene": "s11"
  },
  {
    "text": "Permukaannya naik, membawa pelampung.",
    "start": 53.738333,
    "end": 56.158333,
    "scene": "s11"
  },
  {
    "text": "Pelampung mengendalikan katup pengisi.",
    "start": 56.799229,
    "end": 59.139229,
    "scene": "s12"
  },
  {
    "text": "Saat batasnya tercapai, air masuk berhenti.",
    "start": 59.079229,
    "end": 62.099229,
    "scene": "s12"
  },
  {
    "text": "Sebagian air pengisi melewati selang kecil menuju pipa limpasan, mengisi",
    "start": 63.193167,
    "end": 67.316167,
    "scene": "s13"
  },
  {
    "text": "kembali mangkuk.",
    "start": 67.296167,
    "end": 68.39616699999999,
    "scene": "s13"
  },
  {
    "text": "Kalau air tangki terlalu tinggi, kelebihannya masuk pipa limpasan.",
    "start": 68.808229,
    "end": 72.748229,
    "scene": "s14"
  },
  {
    "text": "Ini jalur cadangan.",
    "start": 72.808229,
    "end": 74.208229,
    "scene": "s14"
  },
  {
    "text": "Perhatikan siklusnya: tuas menarik, flapper membuka, pelampung turun, lalu",
    "start": 74.662104,
    "end": 79.733104,
    "scene": "s15"
  },
  {
    "text": "tangki mengisi lagi.",
    "start": 79.673104,
    "end": 81.173104,
    "scene": "s15"
  },
  {
    "text": "Flapper menahan air.",
    "start": 82.529312,
    "end": 84.02931199999999,
    "scene": "s16"
  },
  {
    "text": "Pelampung mengatur pengisian.",
    "start": 84.009312,
    "end": 85.869312,
    "scene": "s16"
  },
  {
    "text": "Dua tugas, satu tangki siap dipakai lagi.",
    "start": 85.809312,
    "end": 89.069312,
    "scene": "s16"
  }
]