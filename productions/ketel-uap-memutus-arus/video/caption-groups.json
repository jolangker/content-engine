[
  {
    "start": 0.285,
    "end": 1.1950420700000002,
    "text": "Airnya mendidih."
  },
  {
    "start": 1.26905756,
    "end": 2.24354426,
    "text": "Kok ketelnya tahu kapan"
  },
  {
    "start": 2.24354426,
    "end": 2.97,
    "text": "harus mati?"
  },
  {
    "start": 3.54360417,
    "end": 4.6872405299999995,
    "text": "Pada ketel jenis ini,"
  },
  {
    "start": 4.71769508,
    "end": 5.82655871,
    "text": "uap punya saluran menuju"
  },
  {
    "start": 5.82655871,
    "end": 6.77235417,
    "text": "pemutus listrik."
  },
  {
    "start": 6.77235417,
    "end": 7.948604169999999,
    "text": "Kita ikuti jalurnya."
  },
  {
    "start": 8.57339583,
    "end": 9.7149974,
    "text": "Kita ulang dari awal."
  },
  {
    "start": 9.7149974,
    "end": 11.34585677,
    "text": "Saat sakelar ditekan, mekanisme"
  },
  {
    "start": 11.34585677,
    "end": 12.84839583,
    "text": "di dalamnya menutup kontak."
  },
  {
    "start": 13.347,
    "end": 14.81836054,
    "text": "Dua kontak logam bertemu."
  },
  {
    "start": 14.81836054,
    "end": 16.3555034,
    "text": "Rangkaian tersambung, sehingga"
  },
  {
    "start": 16.39237415,
    "end": 17.450469390000002,
    "text": "arus dapat mengalir ke"
  },
  {
    "start": 17.45312245,
    "end": 18.477,
    "text": "elemen pemanas."
  },
  {
    "start": 18.9136875,
    "end": 20.27234267,
    "text": "Hambatan elemen mengubah energi"
  },
  {
    "start": 20.27234267,
    "end": 21.56472198,
    "text": "listrik menjadi panas."
  },
  {
    "start": 21.56472198,
    "end": 22.92337716,
    "text": "Panasnya diteruskan ke air"
  },
  {
    "start": 22.92337716,
    "end": 23.818687500000003,
    "text": "di atasnya."
  },
  {
    "start": 24.37158333,
    "end": 25.57218333,
    "text": "Saat air mendidih, uap"
  },
  {
    "start": 25.57218333,
    "end": 26.90618333,
    "text": "terbentuk dan memenuhi ruang"
  },
  {
    "start": 26.90618333,
    "end": 27.806583330000002,
    "text": "di bawah tutup."
  },
  {
    "start": 28.331375,
    "end": 29.39741817,
    "text": "Sebagian uap masuk ke"
  },
  {
    "start": 29.39741817,
    "end": 30.42907284,
    "text": "saluran khusus."
  },
  {
    "start": 30.42907284,
    "end": 31.835835430000003,
    "text": "Jalurnya membawa uap turun"
  },
  {
    "start": 31.8390009,
    "end": 33.211375000000004,
    "text": "menuju unit pemutus."
  },
  {
    "start": 33.5880625,
    "end": 34.55043287,
    "text": "Di ujung saluran ada"
  },
  {
    "start": 34.55043287,
    "end": 35.81146991,
    "text": "cakram peka panas."
  },
  {
    "start": 35.81146991,
    "end": 36.74065509,
    "text": "Letaknya di luar ruang"
  },
  {
    "start": 36.74065509,
    "end": 38.168062500000005,
    "text": "air, bukan terendam."
  },
  {
    "start": 38.7790625,
    "end": 39.88719862,
    "text": "Cakram ini dibuat dari"
  },
  {
    "start": 39.88719862,
    "end": 41.31157577,
    "text": "dua logam yang disatukan."
  },
  {
    "start": 41.31157577,
    "end": 43.12716116,
    "text": "Ketika dipanaskan, keduanya memuai"
  },
  {
    "start": 43.12716116,
    "end": 44.3990625,
    "text": "dengan besaran berbeda."
  },
  {
    "start": 44.9700625,
    "end": 46.75389107,
    "text": "Karena terikat, perbedaan pemuaian"
  },
  {
    "start": 46.75389107,
    "end": 48.01014393,
    "text": "mengubah kelengkungannya."
  },
  {
    "start": 48.01014393,
    "end": 49.31183393,
    "text": "Bentuk cakram dirancang untuk"
  },
  {
    "start": 49.31183393,
    "end": 50.9600625,
    "text": "berpindah dengan gerakan sentak."
  },
  {
    "start": 51.92585417,
    "end": 53.31952742,
    "text": "Ketika cukup panas, cakram"
  },
  {
    "start": 53.31952742,
    "end": 53.97053643,
    "text": "menyentak."
  },
  {
    "start": 53.97053643,
    "end": 55.37534536,
    "text": "Pada contoh mekanisme ini,"
  },
  {
    "start": 55.37534536,
    "end": 56.54030887,
    "text": "gerak itu mendorong tuas"
  },
  {
    "start": 56.54030887,
    "end": 58.01085417,
    "text": "melewati posisi tengahnya."
  },
  {
    "start": 58.8254375,
    "end": 60.21581165,
    "text": "Pegas kemudian membantu tuas"
  },
  {
    "start": 60.21581165,
    "end": 61.70792049,
    "text": "berpindah ke posisi mati."
  },
  {
    "start": 61.70792049,
    "end": 62.92873682,
    "text": "Perhatikan batang penghubung yang"
  },
  {
    "start": 62.92873682,
    "end": 63.9104375,
    "text": "ikut bergeser."
  },
  {
    "start": 64.6569375,
    "end": 66.19241047,
    "text": "Batang ini memisahkan kontak."
  },
  {
    "start": 66.19241047,
    "end": 67.93261318,
    "text": "Jalur listrik terputus, sehingga"
  },
  {
    "start": 67.93261318,
    "end": 69.09274831,
    "text": "pasokan energi ke elemen"
  },
  {
    "start": 69.09274831,
    "end": 69.80693749999999,
    "text": "berhenti."
  },
  {
    "start": 70.31672917,
    "end": 72.08787983,
    "text": "Pemanasnya mati, tetapi panas"
  },
  {
    "start": 72.08787983,
    "end": 73.10627025,
    "text": "yang sudah tersimpan tidak"
  },
  {
    "start": 73.10627025,
    "end": 73.88703624,
    "text": "langsung hilang."
  },
  {
    "start": 73.88703624,
    "end": 75.44672917,
    "text": "Gelembung mereda setelahnya."
  },
  {
    "start": 75.88341667,
    "end": 77.12440207,
    "text": "Mekanisme tetap di posisi"
  },
  {
    "start": 77.12440207,
    "end": 77.6610444,
    "text": "mati."
  },
  {
    "start": 77.6610444,
    "end": 79.3380517,
    "text": "Untuk menyalakannya lagi, sakelar"
  },
  {
    "start": 79.3380517,
    "end": 80.57841667,
    "text": "perlu ditekan kembali."
  },
  {
    "start": 81.13441667,
    "end": 82.64865716999999,
    "text": "Jadi, pada ketel ini:"
  },
  {
    "start": 82.65213819,
    "end": 84.27334072,
    "text": "air mendidih, uap memanaskan"
  },
  {
    "start": 84.27334072,
    "end": 86.13599895,
    "text": "cakram, tuas bergerak, lalu"
  },
  {
    "start": 86.13599895,
    "end": 87.30878376,
    "text": "kontak terputus."
  },
  {
    "start": 87.30878376,
    "end": 88.68853059,
    "text": "Itulah sebabnya ketel mati"
  },
  {
    "start": 88.68853059,
    "end": 89.40941667,
    "text": "sendiri."
  }
]
