  "scenes": [
    {
      "id": "s01-mystery",
      "key": "mystery",
      "title": "Ditarik, kok kembali?",
      "start": 0,
      "end": 5.133333333333334,
      "duration": 5.133333333333334,
      "view": "whole",
      "text": "Pita meteran ditarik, lalu kembali sendiri. Tapi saat tombol dikunci, kenapa pitanya bisa diam?",
      "action": "Recognizable pull and short return, then lock; matched ending.",
      "word_start": 0,
      "word_end": 14,
      "speech_start": 0.285,
      "speech_end": 4.83,
      "timestamp_anchor_scale": 1.002009464245162,
      "start_frame": 0,
      "end_frame": 154
    },
    {
      "id": "s02-reveal",
      "key": "reveal",
      "title": "Ada pegas terpisah",
      "start": 5.133333333333334,
      "end": 10.7,
      "duration": 5.5666666666666655,
      "view": "section",
      "text": "Di dalamnya ada gulungan pita dan pegas pengembali. Keduanya terhubung, tetapi bukan bagian yang sama.",
      "action": "First discovery at 8 seconds: shell removal exposes separate reel and spring.",
      "word_start": 14,
      "word_end": 29,
      "speech_start": 5.4085625,
      "speech_end": 10.3085625,
      "timestamp_anchor_scale": 0.9318492661138184,
      "start_frame": 154,
      "end_frame": 321
    },
    {
      "id": "s03-pull",
      "key": "pull",
      "title": "Tarikan memutar gulungan",
      "start": 10.7,
      "end": 15.633333333333333,
      "duration": 4.933333333333334,
      "view": "section",
      "text": "Kita mulai saat pita ditarik. Pita terurai, sehingga gulungannya ikut berputar pada poros.",
      "action": "Visible blade translation and coupled reel rotation.",
      "word_start": 29,
      "word_end": 42,
      "speech_start": 11.0583125,
      "speech_end": 15.3633125,
      "timestamp_anchor_scale": 0.9355939997015182,
      "start_frame": 321,
      "end_frame": 469
    },
    {
      "id": "s04-anchor",
      "key": "anchor",
      "title": "Satu sisi ditahan",
      "start": 15.633333333333333,
      "end": 21.066666666666666,
      "duration": 5.433333333333334,
      "view": "spring",
      "text": "Pegas pipih terhubung ke bagian berputar dan tumpuan tetap. Jadi, tarikan pita mengubah bentuk pegas.",
      "action": "Separate axial spring chamber; inner anchor fixed, outer connection follows reel.",
      "word_start": 42,
      "word_end": 57,
      "speech_start": 15.926875,
      "speech_end": 20.756875,
      "timestamp_anchor_scale": 0.9520044044402907,
      "start_frame": 469,
      "end_frame": 632
    },
    {
      "id": "s05-energy",
      "key": "energy",
      "title": "Tarikan menyimpan energi",
      "start": 21.066666666666666,
      "end": 26.433333333333334,
      "duration": 5.366666666666667,
      "view": "spring",
      "text": "Pegas menyimpan energi dari tarikan tadi. Energi inilah yang nantinya memutar gulungan ke arah sebaliknya.",
      "action": "Spring bends under extraction; reverse torque arrow, no independent spring motor.",
      "word_start": 57,
      "word_end": 72,
      "speech_start": 21.358520833333333,
      "speech_end": 26.058520833333333,
      "timestamp_anchor_scale": 0.9245564074479743,
      "start_frame": 632,
      "end_frame": 793
    },
    {
      "id": "s06-return",
      "key": "return",
      "title": "Gulungan menarik pita",
      "start": 26.433333333333334,
      "end": 31.566666666666666,
      "duration": 5.133333333333333,
      "view": "section",
      "text": "Saat tarikan dilepas, pegas menggerakkan gulungan kembali. Pita pun tergulung masuk ke dalam rumahnya.",
      "action": "Release input, reel reverses and blade retracts together.",
      "word_start": 72,
      "word_end": 86,
      "speech_start": 26.791354166666668,
      "speech_end": 31.231354166666666,
      "timestamp_anchor_scale": 0.9419135364989364,
      "start_frame": 793,
      "end_frame": 947
    },
    {
      "id": "s07-question",
      "key": "question",
      "title": "Bagaimana menahannya?",
      "start": 31.566666666666666,
      "end": 36.7,
      "duration": 5.133333333333336,
      "view": "whole",
      "text": "Lalu bagaimana tombol menahannya? Kita lihat contoh meteran dengan pengunci geser dan lidah lentur ini.",
      "action": "Explicit selected variant US5806202A; blade extended for brake inspection.",
      "word_start": 86,
      "word_end": 101,
      "speech_start": 31.931104166666668,
      "speech_end": 36.366104166666666,
      "timestamp_anchor_scale": 0.9306641792643345,
      "start_frame": 947,
      "end_frame": 1101
    },
    {
      "id": "s08-slider",
      "key": "slider",
      "title": "Tombol membawa lidah",
      "start": 36.7,
      "end": 42.03333333333333,
      "duration": 5.333333333333329,
      "view": "lock",
      "text": "Tombol luar terhubung ke pengunci di dalam. Saat digeser, bagian bawah pengunci turun mendekati pita.",
      "action": "Follow finger pad through rib to internal curved slide member.",
      "word_start": 101,
      "word_end": 116,
      "speech_start": 37.02275,
      "speech_end": 41.63775,
      "timestamp_anchor_scale": 0.9381111104823225,
      "start_frame": 1101,
      "end_frame": 1261
    },
    {
      "id": "s09-guide",
      "key": "guide",
      "title": "Pin mengikuti jalur",
      "start": 42.03333333333333,
      "end": 47.56666666666667,
      "duration": 5.5333333333333385,
      "view": "guide",
      "text": "Dua pin kecil mengikuti jalur di rumah meteran. Jalur ini mengarahkan ujung lidah menuju permukaan pita.",
      "action": "One near-side follower pin shown; opposite symmetric pin identified, no detached parts.",
      "word_start": 116,
      "word_end": 132,
      "speech_start": 42.398666666666664,
      "speech_end": 47.178666666666665,
      "timestamp_anchor_scale": 0.940293537787513,
      "start_frame": 1261,
      "end_frame": 1427
    },
    {
      "id": "s10-touch",
      "key": "touch",
      "title": "Ujung menyentuh pita",
      "start": 47.56666666666667,
      "end": 53.03333333333333,
      "duration": 5.4666666666666615,
      "view": "contact",
      "text": "Mula-mula, ujung lidah menyentuh pita. Di bawah pita ada penopang yang menjadi lawan tekanannya.",
      "action": "Signature pose A to B: tip approaches and contacts blade above fixed support.",
      "word_start": 132,
      "word_end": 146,
      "speech_start": 47.96958333333333,
      "speech_end": 52.459583333333335,
      "timestamp_anchor_scale": 0.9391697286972932,
      "start_frame": 1427,
      "end_frame": 1591
    },
    {
      "id": "s11-snap",
      "key": "snap",
      "title": "Lewati tonjolan kecil",
      "start": 53.03333333333333,
      "end": 59.9,
      "duration": 6.866666666666667,
      "view": "guide",
      "text": "Dorongan dilanjutkan. Pin melewati tonjolan kecil, lalu masuk ke permukaan penahan. Gerakan ini membuat lidah makin melentur.",
      "action": "Signature pose B to C: follower crosses detent; tongue tip slides inward, flex increases.",
      "word_start": 146,
      "word_end": 163,
      "speech_start": 53.59025,
      "speech_end": 59.42025,
      "timestamp_anchor_scale": 0.9605540945507923,
      "start_frame": 1591,
      "end_frame": 1797
    },
    {
      "id": "s12-clamp",
      "key": "clamp",
      "title": "Pita terjepit",
      "start": 59.9,
      "end": 65.83333333333333,
      "duration": 5.93333333333333,
      "view": "contact",
      "text": "Lidah yang melentur menekan pita ke penopangnya. Jepitan ini menahan pita agar tidak ditarik kembali oleh pegas.",
      "action": "Signature pose D: settled clamp, reel stays still, reverse torque remains.",
      "word_start": 163,
      "word_end": 180,
      "speech_start": 60.384729166666666,
      "speech_end": 65.42972916666666,
      "timestamp_anchor_scale": 0.96210199198675,
      "start_frame": 1797,
      "end_frame": 1975
    },
    {
      "id": "s13-held",
      "key": "held",
      "title": "Pegas masih menarik",
      "start": 65.83333333333333,
      "end": 71.6,
      "duration": 5.766666666666666,
      "view": "section",
      "text": "Jadi, pegasnya tetap memberi tarikan. Penguncilah yang menahan gerakan, selama jepitannya masih bekerja.",
      "action": "Show spring bias and opposing clamp simultaneously; no detached energy symbol.",
      "word_start": 180,
      "word_end": 193,
      "speech_start": 66.256125,
      "speech_end": 71.286125,
      "timestamp_anchor_scale": 0.9603699503897958,
      "start_frame": 1975,
      "end_frame": 2148
    },
    {
      "id": "s14-unlock",
      "key": "unlock",
      "title": "Jepitan dilepas",
      "start": 71.6,
      "end": 77.36666666666666,
