[
  {
    "start": 0.285,
    "end": 1.58544575,
    "text": "Pita meteran ditarik, lalu"
  },
  {
    "start": 1.58544575,
    "end": 2.42635252,
    "text": "kembali sendiri."
  },
  {
    "start": 2.51157922,
    "end": 3.7846816100000003,
    "text": "Tapi saat tombol dikunci,"
  },
  {
    "start": 3.80816607,
    "end": 4.93,
    "text": "kenapa pitanya bisa diam?"
  },
  {
    "start": 5.4085625,
    "end": 6.32726764,
    "text": "Di dalamnya ada gulungan"
  },
  {
    "start": 6.32726764,
    "end": 7.84887303,
    "text": "pita dan pegas pengembali."
  },
  {
    "start": 7.84887303,
    "end": 9.42789749,
    "text": "Keduanya terhubung, tetapi bukan"
  },
  {
    "start": 9.42789749,
    "end": 10.4085625,
    "text": "bagian yang sama."
  },
  {
    "start": 11.0583125,
    "end": 11.91369164,
    "text": "Kita mulai saat pita"
  },
  {
    "start": 11.91369164,
    "end": 12.55720771,
    "text": "ditarik."
  },
  {
    "start": 12.55720771,
    "end": 14.01790992,
    "text": "Pita terurai, sehingga gulungannya"
  },
  {
    "start": 14.01790992,
    "end": 15.463312499999999,
    "text": "ikut berputar pada poros."
  },
  {
    "start": 15.926875,
    "end": 16.88524907,
    "text": "Pegas pipih terhubung ke"
  },
  {
    "start": 16.88524907,
    "end": 18.02913855,
    "text": "bagian berputar dan tumpuan"
  },
  {
    "start": 18.02913855,
    "end": 18.58641804,
    "text": "tetap."
  },
  {
    "start": 18.58641804,
    "end": 19.96495151,
    "text": "Jadi, tarikan pita mengubah"
  },
  {
    "start": 19.96495151,
    "end": 20.856875000000002,
    "text": "bentuk pegas."
  },
  {
    "start": 21.35852083,
    "end": 22.46942992,
    "text": "Pegas menyimpan energi dari"
  },
  {
    "start": 22.46942992,
    "end": 23.34320265,
    "text": "tarikan tadi."
  },
  {
    "start": 23.34320265,
    "end": 24.34942992,
    "text": "Energi inilah yang nantinya"
  },
  {
    "start": 24.34942992,
    "end": 25.31791477,
    "text": "memutar gulungan ke arah"
  },
  {
    "start": 25.31791477,
    "end": 26.15852083,
    "text": "sebaliknya."
  },
  {
    "start": 26.79135417,
    "end": 28.0101777,
    "text": "Saat tarikan dilepas, pegas"
  },
  {
    "start": 28.0101777,
    "end": 28.74860907,
    "text": "menggerakkan gulungan"
  },
  {
    "start": 28.8611777,
    "end": 29.34507966,
    "text": "kembali."
  },
  {
    "start": 29.34507966,
    "end": 30.2446875,
    "text": "Pita pun tergulung masuk"
  },
  {
    "start": 30.2446875,
    "end": 31.33135417,
    "text": "ke dalam rumahnya."
  },
  {
    "start": 31.93110417,
    "end": 33.57478527,
    "text": "Lalu bagaimana tombol menahannya?"
  },
  {
    "start": 33.57478527,
    "end": 34.51167633,
    "text": "Kita lihat contoh meteran"
  },
  {
    "start": 34.51167633,
    "end": 35.45788613,
    "text": "dengan pengunci geser dan"
  },
  {
    "start": 35.45788613,
    "end": 35.93063544,
    "text": "lidah lentur"
  },
  {
    "start": 36.08869266,
    "end": 36.46610417,
    "text": "ini."
  },
  {
    "start": 37.02275,
    "end": 37.96713782,
    "text": "Tombol luar terhubung ke"
  },
  {
    "start": 37.96713782,
    "end": 38.9498214,
    "text": "pengunci di dalam."
  },
  {
    "start": 38.9498214,
    "end": 40.22152955,
    "text": "Saat digeser, bagian bawah"
  },
  {
    "start": 40.22152955,
    "end": 41.73775,
    "text": "pengunci turun mendekati pita."
  },
  {
    "start": 42.39866667,
    "end": 43.41260606,
    "text": "Dua pin kecil mengikuti"
  },
  {
    "start": 43.41260606,
    "end": 44.62933333,
    "text": "jalur di rumah meteran."
  },
  {
    "start": 44.62933333,
    "end": 45.70121212,
    "text": "Jalur ini mengarahkan ujung"
  },
  {
    "start": 45.70121212,
    "end": 47.27866667,
    "text": "lidah menuju permukaan pita."
  },
  {
    "start": 47.96958333,
    "end": 49.42140064,
    "text": "Mula-mula, ujung lidah menyentuh"
  },
  {
    "start": 49.42140064,
    "end": 50.0001021,
    "text": "pita."
  },
  {
    "start": 50.0001021,
    "end": 50.75241401,
    "text": "Di bawah pita ada"
  },
  {
    "start": 50.75241401,
    "end": 51.7362065,
    "text": "penopang yang menjadi lawan"
  },
  {
    "start": 51.7362065,
    "end": 52.55958333,
    "text": "tekanannya."
  },
  {
    "start": 53.59025,
    "end": 54.71481853,
    "text": "Dorongan dilanjutkan."
  },
  {
    "start": 54.71481853,
    "end": 55.95776269,
    "text": "Pin melewati tonjolan kecil,"
  },
  {
    "start": 55.95776269,
    "end": 56.84557995,
    "text": "lalu masuk ke permukaan"
  },
  {
    "start": 56.84557995,
    "end": 57.49664594,
    "text": "penahan."
  },
  {
    "start": 57.49664594,
    "end": 58.53243274,
    "text": "Gerakan ini membuat lidah"
  },
  {
    "start": 58.53243274,
    "end": 59.520250000000004,
    "text": "makin melentur."
  },
  {
    "start": 60.38472917,
    "end": 61.4814683,
    "text": "Lidah yang melentur menekan"
  },
  {
    "start": 61.4814683,
    "end": 62.57820743,
    "text": "pita ke penopangnya."
  },
  {
    "start": 62.57820743,
    "end": 63.74530496,
    "text": "Jepitan ini menahan pita"
  },
  {
    "start": 63.76387135,
    "end": 64.71240249,
    "text": "agar tidak ditarik kembali"
  },
  {
    "start": 64.71240249,
    "end": 65.52972917,
    "text": "oleh pegas."
  },
  {
    "start": 66.256125,
    "end": 67.67636029,
    "text": "Jadi, pegasnya tetap memberi"
  },
  {
    "start": 67.67636029,
    "end": 68.32730147,
    "text": "tarikan."
  },
  {
    "start": 68.32730147,
    "end": 69.68836029,
    "text": "Penguncilah yang menahan gerakan,"
  },
  {
    "start": 69.68836029,
    "end": 71.38612499999999,
    "text": "selama jepitannya masih bekerja."
  },
  {
    "start": 71.920875,
    "end": 73.17480564,
    "text": "Saat tombol digeser kembali,"
  },
  {
    "start": 73.17480564,
    "end": 74.07047038,
    "text": "pin keluar dari posisi"
  },
  {
    "start": 74.07047038,
    "end": 74.72729118,
    "text": "penahan."
  },
  {
    "start": 74.72729118,
    "end": 75.95136633,
    "text": "Lidah terangkat, dan jepitan"
  },
  {
    "start": 75.95136633,
    "end": 77.185875,
    "text": "pada pita terlepas."
  },
  {
    "start": 77.63752083,
    "end": 78.86152083,
    "text": "Sekarang pegas bisa memutar"
  },
  {
    "start": 78.86152083,
    "end": 79.67752083,
    "text": "gulungan lagi."
  },
  {
    "start": 79.67752083,
    "end": 81.01809226,
    "text": "Pita bergerak masuk, sementara"
  },
  {
    "start": 81.01809226,
    "end": 82.06723512,
    "text": "pengunci tetap menjauh dari"
  },
  {
    "start": 82.06723512,
    "end": 82.83752082999999,
    "text": "jalurnya."
  },
  {
    "start": 83.4184375,
    "end": 84.88047832,
    "text": "Jadi, yang mengembalikan pita"
  },
  {
    "start": 84.88047832,
    "end": 85.73333546,
    "text": "adalah pegas."
  },
  {
    "start": 85.73333546,
    "end": 86.82986607,
    "text": "Yang membuatnya diam adalah"
  },
  {
    "start": 86.82986607,
    "end": 87.86547832,
    "text": "jepitan pengunci."
  },
  {
    "start": 87.86547832,
    "end": 89.48843749999999,
    "text": "Tombolnya mengatur jepitan itu."
  }
]
