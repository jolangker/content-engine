[
  {
    "start": 0.193,
    "end": 2.365,
    "text": "Dia bilang, nanti kita bahas.",
    "dark": false,
    "scene": 1
  },
  {
    "start": 2.365,
    "end": 5.05,
    "text": "Lo jadi lebih tenang, atau malah bingung:",
    "dark": false,
    "scene": 1
  },
  {
    "start": 5.085,
    "end": 6.49,
    "text": "nanti itu kapan?",
    "dark": false,
    "scene": 1
  },
  {
    "start": 6.925,
    "end": 9.085,
    "text": "Jeda bisa memberi ruang buat menenangkan",
    "dark": false,
    "scene": 2
  },
  {
    "start": 9.085,
    "end": 9.805,
    "text": "diri.",
    "dark": false,
    "scene": 2
  },
  {
    "start": 9.805,
    "end": 12.666,
    "text": "Obrolannya tetap perlu punya waktu kembali.",
    "dark": false,
    "scene": 2
  },
  {
    "start": 13.069,
    "end": 15.805,
    "text": "Misalnya, kalian membahas rencana yang berubah.",
    "dark": false,
    "scene": 3
  },
  {
    "start": 15.805,
    "end": 18.005,
    "text": "Nada mulai naik, dan jawaban makin",
    "dark": false,
    "scene": 3
  },
  {
    "start": 18.005,
    "end": 18.66,
    "text": "pendek.",
    "dark": false,
    "scene": 3
  },
  {
    "start": 18.685,
    "end": 19.912,
    "text": "Satu orang pergi.",
    "dark": true,
    "scene": 4
  },
  {
    "start": 19.912,
    "end": 22.125,
    "text": "Yang lain masih duduk dengan pertanyaan yang belum",
    "dark": true,
    "scene": 4
  },
  {
    "start": 22.125,
    "end": 23.17,
    "text": "selesai.",
    "dark": true,
    "scene": 4
  },
  {
    "start": 23.905,
    "end": 25.425,
    "text": "Lo mungkin butuh tenang.",
    "dark": false,
    "scene": 5
  },
  {
    "start": 25.425,
    "end": 27.958,
    "text": "Dia mungkin belum tahu apakah percakapan ini bakal",
    "dark": false,
    "scene": 5
  },
  {
    "start": 27.958,
    "end": 29.11,
    "text": "dilanjutkan.",
    "dark": false,
    "scene": 5
  },
  {
    "start": 29.161,
    "end": 31.825,
    "text": "Satu jeda belum menjelaskan niat seseorang.",
    "dark": false,
    "scene": 6
  },
  {
    "start": 31.825,
    "end": 34.23,
    "text": "Lihat juga cara jedanya dibicarakan.",
    "dark": false,
    "scene": 6
  },
  {
    "start": 34.665,
    "end": 37.465,
    "text": "Saat suasana tenang, sepakati bagaimana kalian",
    "dark": false,
    "scene": 7
  },
  {
    "start": 37.465,
    "end": 39.71,
    "text": "meminta jeda dan kembali ngobrol.",
    "dark": false,
    "scene": 7
  },
  {
    "start": 39.895,
    "end": 42.735,
    "text": "Ketika mulai kewalahan, bilang kondisi lo dan minta",
    "dark": false,
    "scene": 8
  },
  {
    "start": 42.735,
    "end": 44.669,
    "text": "waktu, tanpa menyerang.",
    "dark": false,
    "scene": 8
  },
  {
    "start": 44.694,
    "end": 46.031,
    "text": "Gua mulai susah dengar.",
    "dark": false,
    "scene": 9
  },
  {
    "start": 46.031,
    "end": 47.151,
    "text": "Gua mau tenang dulu.",
    "dark": false,
    "scene": 9
  },
  {
    "start": 47.151,
    "end": 48.716,
    "text": "Kita lanjut jam delapan, ya?",
    "dark": false,
    "scene": 9
  },
  {
    "start": 49.015,
    "end": 51.201,
    "text": "Jam delapan cuma contoh kesepakatan.",
    "dark": false,
    "scene": 10
  },
  {
    "start": 51.201,
    "end": 53.599,
    "text": "Pilih waktu yang realistis buat kalian.",
    "dark": false,
    "scene": 10
  },
  {
    "start": 53.818,
    "end": 56.591,
    "text": "Selama jeda, lakukan hal yang menenangkan.",
    "dark": false,
    "scene": 11
  },
  {
    "start": 56.591,
    "end": 59.263,
    "text": "Jangan sibuk menyusun balasan buat menyerang.",
    "dark": false,
    "scene": 11
  },
  {
    "start": 59.768,
    "end": 61.831,
    "text": "Lalu, benar-benar kembali.",
    "dark": true,
    "scene": 12
  },
  {
    "start": 61.831,
    "end": 63.938,
    "text": "Kesepakatan tadi perlu kelihatan dalam",
    "dark": true,
    "scene": 12
  },
  {
    "start": 63.938,
    "end": 64.903,
    "text": "tindakan.",
    "dark": true,
    "scene": 12
  },
  {
    "start": 65.638,
    "end": 68.438,
    "text": "Kalau belum siap, kabari dan sepakati ulang.",
    "dark": false,
    "scene": 13
  },
  {
    "start": 68.438,
    "end": 70.696,
    "text": "Jangan membiarkan orang lain menebak.",
    "dark": false,
    "scene": 13
  },
  {
    "start": 70.895,
    "end": 73.188,
    "text": "Pas balik, mulai dari persoalan yang tadi",
    "dark": false,
    "scene": 14
  },
  {
    "start": 73.188,
    "end": 73.961,
    "text": "tertunda.",
    "dark": false,
    "scene": 14
  },
  {
    "start": 73.961,
    "end": 76.006,
    "text": "Nggak harus langsung beres semuanya.",
    "dark": false,
    "scene": 14
  },
  {
    "start": 76.205,
    "end": 78.898,
    "text": "Kalau berulang kali nggak dilanjutkan, bicarakan pola",
    "dark": false,
    "scene": 15
  },
  {
    "start": 78.898,
    "end": 81.351,
    "text": "penundaannya saat suasana lebih tenang.",
    "dark": false,
    "scene": 15
  },
  {
    "start": 81.568,
    "end": 83.861,
    "text": "Jadi, kalau bilang nanti, coba",
    "dark": false,
    "scene": 16
  },
  {
    "start": 83.861,
    "end": 86.648,
    "text": "lengkapi: kapan kita kembali, dan siapa yang",
    "dark": false,
    "scene": 16
  },
  {
    "start": 86.648,
    "end": 87.293,
    "text": "mulai?",
    "dark": false,
    "scene": 16
  }
]
