[
  {
    "start": 0.53,
    "end": 2.01,
    "text": "Kita menekan dari atas."
  },
  {
    "start": 2.21,
    "end": 2.61,
    "text": "Tapi"
  },
  {
    "start": 2.85,
    "end": 3.97,
    "text": "siapa yang menekuk kaki"
  },
  {
    "start": 4.05,
    "end": 4.85,
    "text": "staples di bawah"
  },
  {
    "start": 5.037,
    "end": 5.61,
    "text": "kertas?"
  },
  {
    "start": 5.882,
    "end": 7.17,
    "text": "Kita ikuti stapler manual"
  },
  {
    "start": 7.25,
    "end": 9.09,
    "text": "biasa, dengan kaki staples"
  },
  {
    "start": 9.17,
    "end": 10.53,
    "text": "yang dilipat ke dalam."
  },
  {
    "start": 10.57,
    "end": 12.21,
    "text": "Di dalamnya ada magazen,"
  },
  {
    "start": 12.29,
    "end": 13.97,
    "text": "pengumpan berpegas, dan bilah"
  },
  {
    "start": 14.05,
    "end": 15.57,
    "text": "penekan di ujung depan."
  },
  {
    "start": 15.623,
    "end": 17.25,
    "text": "Pengumpan menekan deretan staples"
  },
  {
    "start": 17.33,
    "end": 18.93,
    "text": "ke depan, sampai staples"
  },
  {
    "start": 19.05,
    "end": 20.29,
    "text": "pertama berada di jalur"
  },
  {
    "start": 20.37,
    "end": 21.09,
    "text": "bilah."
  },
  {
    "start": 21.13,
    "end": 22.37,
    "text": "Jalur sempit ini menuntun"
  },
  {
    "start": 22.45,
    "end": 24.05,
    "text": "staples pertama saat didorong"
  },
  {
    "start": 24.13,
    "end": 24.69,
    "text": "turun."
  },
  {
    "start": 24.73,
    "end": 26.61,
    "text": "Sisanya tetap di magazen."
  },
  {
    "start": 26.65,
    "end": 28.37,
    "text": "Saat kepala ditekan, lengan"
  },
  {
    "start": 28.45,
    "end": 29.97,
    "text": "berputar pada engsel belakang"
  },
  {
    "start": 30.05,
    "end": 32.05,
    "text": "dan magazen mendekati kertas."
  },
  {
    "start": 32.13,
    "end": 33.57,
    "text": "Bilah logam kemudian menekan"
  },
  {
    "start": 33.65,
    "end": 35.73,
    "text": "punggung staples pertama, meneruskan"
  },
  {
    "start": 35.81,
    "end": 37.25,
    "text": "gaya tangan ke kawat."
  },
  {
    "start": 37.303,
    "end": 38.21,
    "text": "Kedua kaki yang masih"
  },
  {
    "start": 38.25,
    "end": 39.57,
    "text": "lurus menembus lembaran"
  },
  {
    "start": 39.757,
    "end": 40.45,
    "text": "kertas."
  },
  {
    "start": 40.53,
    "end": 42.29,
    "text": "Belum terlipat menjadi pengunci."
  },
  {
    "start": 42.53,
    "end": 43.89,
    "text": "Di bawah kertas, ujung"
  },
  {
    "start": 43.97,
    "end": 45.41,
    "text": "kakinya mencapai alur pada"
  },
  {
    "start": 45.49,
    "end": 47.01,
    "text": "pelat logam, yang disebut"
  },
  {
    "start": 47.09,
    "end": 48.05,
    "text": "landasan."
  },
  {
    "start": 48.13,
    "end": 49.25,
    "text": "Tekanan berlanjut."
  },
  {
    "start": 49.33,
    "end": 50.93,
    "text": "Permukaan alur mengarahkan ujung"
  },
  {
    "start": 51.01,
    "end": 52.21,
    "text": "kaki ke dalam sambil"
  },
  {
    "start": 52.29,
    "end": 53.33,
    "text": "kawat menekuk."
  },
  {
    "start": 53.41,
    "end": 55.25,
    "text": "Landasannya tidak perlu bergerak."
  },
  {
    "start": 55.33,
    "end": 56.61,
    "text": "Bilah tetap mendorong dari"
  },
  {
    "start": 56.85,
    "end": 59.01,
    "text": "atas, alur membelokkan kaki."
  },
  {
    "start": 59.05,
    "end": 60.45,
    "text": "Punggung staples tertahan di"
  },
  {
    "start": 60.53,
    "end": 61.17,
    "text": "atas."
  },
  {
    "start": 61.33,
    "end": 62.77,
    "text": "Kaki yang terlipat menahan"
  },
  {
    "start": 62.85,
    "end": 63.97,
    "text": "lembaran dari bawah."
  },
  {
    "start": 64.21,
    "end": 65.89,
    "text": "Saat tangan dilepas, pegas"
  },
  {
    "start": 65.93,
    "end": 67.89,
    "text": "mengembalikan mekanisme penekan."
  },
  {
    "start": 67.97,
    "end": 69.25,
    "text": "Bilah naik dan jalur"
  },
  {
    "start": 69.33,
    "end": 70.45,
    "text": "depan terbuka."
  },
  {
    "start": 70.503,
    "end": 72.37,
    "text": "Pengumpan berpegas memajukan deretan"
  },
  {
    "start": 72.41,
    "end": 74.45,
    "text": "staples lagi, menempatkan staples"
  },
  {
    "start": 74.49,
    "end": 76.21,
    "text": "berikutnya di bawah bilah."
  },
  {
    "start": 76.25,
    "end": 78.45,
    "text": "Sekarang lihat utuh: tekan,"
  },
  {
    "start": 78.53,
    "end": 80.61,
    "text": "tembus, tekuk, lalu kembali"
  },
  {
    "start": 80.69,
    "end": 81.33,
    "text": "siap."
  },
  {
    "start": 81.37,
    "end": 83.17,
    "text": "Gerak cepatnya kita perlambat."
  },
  {
    "start": 83.25,
    "end": 85.81,
    "text": "Jadi, bilah mendorong staples."
  },
  {
    "start": 85.85,
    "end": 87.33,
    "text": "Bentuk alur landasanlah yang"
  },
  {
    "start": 87.41,
    "end": 89.09,
    "text": "menentukan tekukan kakinya."
  }
]
