[
  {
    "start": 0.367,
    "end": 1.74,
    "text": "Kotak ini bisa memainkan"
  },
  {
    "start": 1.74,
    "end": 3.15,
    "text": "lagu tanpa baterai."
  },
  {
    "start": 3.26,
    "end": 4.7059999999999995,
    "text": "Siapa yang menyimpan nadanya?"
  },
  {
    "start": 5.02,
    "end": 6.14,
    "text": "Kita buka kotak musik"
  },
  {
    "start": 6.14,
    "end": 8.14,
    "text": "pegas, dengan silinder berpaku"
  },
  {
    "start": 8.14,
    "end": 9.58,
    "text": "dan pengatur kecepatan jenis"
  },
  {
    "start": 9.58,
    "end": 10.5,
    "text": "gesek."
  },
  {
    "start": 10.5,
    "end": 12.3,
    "text": "Saat kuncinya diputar, pegas"
  },
  {
    "start": 12.3,
    "end": 13.78,
    "text": "di dalam rumahnya digulung"
  },
  {
    "start": 13.78,
    "end": 15.313,
    "text": "untuk menyimpan energi."
  },
  {
    "start": 15.313,
    "end": 17.3,
    "text": "Ketika mekanisme berjalan, pegas"
  },
  {
    "start": 17.3,
    "end": 18.82,
    "text": "mengendur dan menggerakkan roda"
  },
  {
    "start": 18.82,
    "end": 19.94,
    "text": "gigi penggerak."
  },
  {
    "start": 19.94,
    "end": 21.06,
    "text": "Gigi yang saling bertaut"
  },
  {
    "start": 21.06,
    "end": 23.34,
    "text": "meneruskan putaran, menuju silinder"
  },
  {
    "start": 23.34,
    "end": 25.47,
    "text": "dan rangkaian pengatur kecepatan."
  },
  {
    "start": 25.58,
    "end": 27.02,
    "text": "Silinder ini bukan pengeras"
  },
  {
    "start": 27.02,
    "end": 27.86,
    "text": "suara."
  },
  {
    "start": 27.86,
    "end": 29.54,
    "text": "Di permukaannya, ada pin"
  },
  {
    "start": 29.54,
    "end": 30.66,
    "text": "yang menonjol."
  },
  {
    "start": 30.66,
    "end": 32.06,
    "text": "Letak pin menentukan gigi"
  },
  {
    "start": 32.06,
    "end": 33.5,
    "text": "sisir mana yang dipetik,"
  },
  {
    "start": 33.5,
    "end": 34.82,
    "text": "dan kapan petikan itu"
  },
  {
    "start": 34.82,
    "end": 35.59,
    "text": "terjadi."
  },
  {
    "start": 35.804,
    "end": 37.07,
    "text": "Perhatikan satu pin."
  },
  {
    "start": 37.18,
    "end": 38.86,
    "text": "Saat mendekat, pin mengangkat"
  },
  {
    "start": 38.86,
    "end": 40.62,
    "text": "ujung gigi sisir logam."
  },
  {
    "start": 40.62,
    "end": 42.02,
    "text": "Setelah pin lewat, gigi"
  },
  {
    "start": 42.02,
    "end": 43.75,
    "text": "itu terlepas dan bergetar."
  },
  {
    "start": 43.82,
    "end": 45.34,
    "text": "Getaran inilah yang menghasilkan"
  },
  {
    "start": 45.34,
    "end": 46.1,
    "text": "nada."
  },
  {
    "start": 46.1,
    "end": 47.86,
    "text": "Gigi-gigi sisir disetel untuk"
  },
  {
    "start": 47.86,
    "end": 49.02,
    "text": "nada berbeda."
  },
  {
    "start": 49.02,
    "end": 51.3,
    "text": "Urutan petikannya membentuk lagu."
  },
  {
    "start": 51.3,
    "end": 52.82,
    "text": "Tapi putaran juga perlu"
  },
  {
    "start": 52.82,
    "end": 53.82,
    "text": "dibatasi."
  },
  {
    "start": 53.82,
    "end": 55.34,
    "text": "Rangkaian roda gigi ikut"
  },
  {
    "start": 55.34,
    "end": 56.94,
    "text": "memutar governor, pengatur"
  },
  {
    "start": 56.94,
    "end": 58.02,
    "text": "kecepatannya."
  },
  {
    "start": 58.02,
    "end": 59.42,
    "text": "Pada jenis ini, dua"
  },
  {
    "start": 59.42,
    "end": 60.86,
    "text": "sayap lentur mengembang saat"
  },
  {
    "start": 60.86,
    "end": 62.74,
    "text": "berputar, lalu menyentuh dinding"
  },
  {
    "start": 62.74,
    "end": 63.7,
    "text": "cakram."
  },
  {
    "start": 63.7,
    "end": 65.74,
    "text": "Sentuhan itu menimbulkan gesekan,"
  },
  {
    "start": 65.74,
    "end": 67.26,
    "text": "yang menahan laju mekanisme"
  },
  {
    "start": 67.26,
    "end": 69.26,
    "text": "agar tidak melesat bebas."
  },
  {
    "start": 69.26,
    "end": 71.62,
    "text": "Jadi, governor mengatur laju."
  },
  {
    "start": 71.62,
    "end": 72.86,
    "text": "Pola pin memilih urutan"
  },
  {
    "start": 72.86,
    "end": 75.55,
    "text": "petikan; sisir menghasilkan nadanya."
  },
  {
    "start": 75.82,
    "end": 78.06,
    "text": "Selama lagu berjalan, pegas,"
  },
  {
    "start": 78.06,
    "end": 79.98,
    "text": "roda gigi, silinder, dan"
  },
  {
    "start": 79.98,
    "end": 81.98,
    "text": "governor bekerja sebagai satu"
  },
  {
    "start": 81.98,
    "end": 82.67,
    "text": "rangkaian."
  },
  {
    "start": 83.002,
    "end": 84.91,
    "text": "Tenaganya tersimpan di pegas."
  },
  {
    "start": 85.1,
    "end": 86.78,
    "text": "Lagunya tersusun sebagai pola"
  },
  {
    "start": 86.78,
    "end": 88.22,
    "text": "pin, yang dibaca lewat"
  },
  {
    "start": 88.22,
    "end": 89.31,
    "text": "petikan logam."
  }
]
