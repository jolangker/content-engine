[
  {
    "start": 0.265,
    "end": 1.65105505,
    "text": "Baling-balingnya terus searah."
  },
  {
    "start": 1.70059633,
    "end": 2.69784404,
    "text": "Kenapa kepala kipas bisa"
  },
  {
    "start": 2.71747706,
    "end": 3.625,
    "text": "bergerak bolak-balik?"
  },
  {
    "start": 4.15745833,
    "end": 5.22839793,
    "text": "Pada tipe mekanis ini,"
  },
  {
    "start": 5.24262612,
    "end": 6.09933753,
    "text": "satu motor menggerakkan"
  },
  {
    "start": 6.09933753,
    "end": 7.41296169,
    "text": "baling-baling sekaligus mekanisme"
  },
  {
    "start": 7.41296169,
    "end": 8.51245833,
    "text": "ayunan di belakangnya."
  },
  {
    "start": 9.05491667,
    "end": 10.20070046,
    "text": "Bagian belakang poros berbentuk"
  },
  {
    "start": 10.20070046,
    "end": 10.71630317,
    "text": "ulir."
  },
  {
    "start": 10.71630317,
    "end": 11.89073156,
    "text": "Ulir ini meneruskan putaran"
  },
  {
    "start": 11.89073156,
    "end": 13.06991667,
    "text": "ke rangkaian roda gigi."
  },
  {
    "start": 13.607375,
    "end": 14.54981647,
    "text": "Rangkaian itu menggerakkan"
  },
  {
    "start": 14.54981647,
    "end": 15.35741742,
    "text": "piringan di bawah rumah"
  },
  {
    "start": 15.35741742,
    "end": 16.0496468,
    "text": "roda gigi."
  },
  {
    "start": 16.0496468,
    "end": 17.20336244,
    "text": "Piringan berputar bersama pin"
  },
  {
    "start": 17.20336244,
    "end": 17.957375000000003,
    "text": "di tepinya."
  },
  {
    "start": 18.48483333,
    "end": 19.01482223,
    "text": "Perhatikan pin"
  },
  {
    "start": 19.11992767,
    "end": 19.38363467,
    "text": "ini."
  },
  {
    "start": 19.38363467,
    "end": 20.67286885,
    "text": "Letaknya menjauh dari pusat,"
  },
  {
    "start": 20.67286885,
    "end": 21.96210303,
    "text": "sehingga pin berjalan melingkar"
  },
  {
    "start": 21.96210303,
    "end": 23.204833330000003,
    "text": "ketika piringan berputar."
  },
  {
    "start": 23.82254167,
    "end": 24.7011131,
    "text": "Pin tersambung ke batang"
  },
  {
    "start": 24.7011131,
    "end": 25.34539881,
    "text": "penghubung."
  },
  {
    "start": 25.34539881,
    "end": 26.83897024,
    "text": "Sambungannya bisa berputar, jadi"
  },
  {
    "start": 26.83897024,
    "end": 28.03968452,
    "text": "batang mengikuti perjalanan pin"
  },
  {
    "start": 28.03968452,
    "end": 29.04754167,
    "text": "tanpa terlepas."
  },
  {
    "start": 29.667,
    "end": 30.42827929,
    "text": "Ujung batang yang lain"
  },
  {
    "start": 30.42827929,
    "end": 31.36523841,
    "text": "terpasang pada jangkar di"
  },
  {
    "start": 31.36523841,
    "end": 31.98011784,
    "text": "penyangga."
  },
  {
    "start": 31.98011784,
    "end": 33.03419685,
    "text": "Jangkar ini tetap, tidak"
  },
  {
    "start": 33.03419685,
    "end": 34.047000000000004,
    "text": "ikut kepala kipas."
  },
  {
    "start": 34.68145833,
    "end": 35.7476815,
    "text": "Inilah kuncinya."
  },
  {
    "start": 35.7476815,
    "end": 37.03575153,
    "text": "Batang tidak memanjang."
  },
  {
    "start": 37.03575153,
    "end": 38.12234839,
    "text": "Saat pin bergerak, rumah"
  },
  {
    "start": 38.12234839,
    "end": 39.23912849,
    "text": "roda gigi harus bergeser"
  },
  {
    "start": 39.23912849,
    "end": 40.54645833,
    "text": "mengelilingi poros kepala."
  },
  {
    "start": 41.04891667,
    "end": 42.09794892,
    "text": "Rumah roda gigi terikat"
  },
  {
    "start": 42.09794892,
    "end": 42.489346770000004,
    "text": "pada badan"
  },
  {
    "start": 42.62246505,
    "end": 42.9138629,
    "text": "motor."
  },
  {
    "start": 42.9138629,
    "end": 44.48741129,
    "text": "Jadi, ketika mekanisme bergerak,"
  },
  {
    "start": 44.48741129,
    "end": 45.71128226,
    "text": "seluruh kepala ikut berayun"
  },
  {
    "start": 45.71128226,
    "end": 46.56891667,
    "text": "ke satu sisi."
  },
  {
    "start": 47.051375,
    "end": 48.30082224,
    "text": "Pin terus mengitari piringan."
  },
  {
    "start": 48.30082224,
    "end": 49.22303329,
    "text": "Setelah melewati bagian"
  },
  {
    "start": 49.22303329,
    "end": 50.56172676,
    "text": "lintasannya, arah gerak kepala"
  },
  {
    "start": 50.56172676,
    "end": 52.10866143,
    "text": "berbalik, meskipun piringan tetap"
  },
  {
    "start": 52.10866143,
    "end": 53.071375,
    "text": "berputar searah."
  },
  {
    "start": 53.55883333,
    "end": 54.64456469,
    "text": "Batang kini membawa kepala"
  },
  {
    "start": 54.64456469,
    "end": 55.00866151,
    "text": "ke sisi"
  },
  {
    "start": 55.14341424,
    "end": 55.45666241,
    "text": "lain."
  },
  {
    "start": 55.45666241,
    "end": 56.66930696,
    "text": "Gerakan melingkar berubah menjadi"
  },
  {
    "start": 56.66930696,
    "end": 58.119135140000004,
    "text": "ayunan melalui sambungan-sambungan"
  },
  {
    "start": 58.22454378,
    "end": 58.568833330000004,
    "text": "ini."
  },
  {
    "start": 59.19829167,
    "end": 60.05458167,
    "text": "Poros di leher menopang"
  },
  {
    "start": 60.05458167,
    "end": 60.98898167,
    "text": "kepala yang berayun."
  },
  {
    "start": 60.98898167,
    "end": 62.09858167,
    "text": "Jangkar batang tetap berada"
  },
  {
    "start": 62.09858167,
    "end": 63.67829167,
    "text": "pada penyangga sebagai acuannya."
  },
  {
    "start": 64.27425,
    "end": 65.29006139,
    "text": "Pada tipe ini, kenop"
  },
  {
    "start": 65.29006139,
    "end": 66.40327935,
    "text": "yang diangkat melepas kopling"
  },
  {
    "start": 66.40327935,
    "end": 67.28213563,
    "text": "mekanisme ayunan."
  },
  {
    "start": 67.28213563,
    "end": 68.68830568,
    "text": "Piringan berhenti digerakkan, dan"
  },
  {
    "start": 68.68830568,
    "end": 70.21424999999999,
    "text": "kepala mempertahankan arahnya."
  },
  {
    "start": 70.71670833,
    "end": 71.77008538,
    "text": "Baling-baling tetap berputar"
  },
  {
    "start": 71.77008538,
    "end": 72.80353167,
    "text": "karena poros motor masih"
  },
  {
    "start": 72.80353167,
    "end": 73.59116538,
    "text": "menggerakkannya."
  },
  {
    "start": 73.59116538,
    "end": 74.60468093,
    "text": "Yang dilepas hanya jalur"
  },
  {
    "start": 74.60468093,
    "end": 75.82670832999999,
    "text": "menuju mekanisme ayunan."
  },
  {
    "start": 76.30916667,
    "end": 77.60346388,
    "text": "Ketika kenop ditekan, jalur"
  },
  {
    "start": 77.60346388,
    "end": 78.76024201,
    "text": "ayunan tersambung lagi."
  },
  {
    "start": 78.76024201,
    "end": 80.16264245,
    "text": "Roda gigi, piringan, dan"
  },
  {
    "start": 80.16264245,
    "end": 81.70916666999999,
    "text": "batang kembali bekerja bersama."
  },
  {
    "start": 82.281875,
    "end": 83.53119703,
    "text": "Jadi, motor tidak perlu"
  },
  {
    "start": 83.53119703,
    "end": 84.2056822,
    "text": "bolak-balik."
  },
  {
    "start": 84.2056822,
    "end": 85.49441737,
    "text": "Pin berputar, batang menjaga"
  },
  {
    "start": 85.49441737,
    "end": 86.68424788,
    "text": "jarak terhadap penyangga, dan"
  },
  {
    "start": 86.68424788,
    "end": 87.57662076,
    "text": "kepala berayun."
  },
  {
    "start": 87.57662076,
    "end": 88.64746822,
    "text": "Itulah gerakan yang terlihat"
  },
  {
    "start": 88.64746822,
    "end": 89.40187499999999,
    "text": "dari luar."
  }
]
