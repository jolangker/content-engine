  "scenes": [
    {
      "id": "s01-mystery",
      "key": "mystery",
      "start": 0,
      "end": 3.8333333333333335,
      "duration": 3.8333333333333335,
      "title": "Kenapa bisa bolak-balik?",
      "text": "Baling-balingnya terus searah. Kenapa kepala kipas bisa bergerak bolak-balik?",
      "view": "whole",
      "job": "Recognizable fan: continuous blade rotation and head yaw.",
      "word_start": 0,
      "word_end": 9,
      "speech_start": 0.265,
      "speech_end": 3.525,
      "timestamp_anchor_scale": 0.9815673703990272,
      "start_frame": 0,
      "end_frame": 115
    },
    {
      "id": "s02-branch",
      "key": "branch",
      "start": 3.8333333333333335,
      "end": 8.733333333333333,
      "duration": 4.899999999999999,
      "title": "Satu motor, dua jalur",
      "text": "Pada tipe mekanis ini, satu motor menggerakkan baling-baling sekaligus mekanisme ayunan di belakangnya.",
      "view": "side",
      "job": "First discovery: front blade and rear worm share a shaft.",
      "word_start": 9,
      "word_end": 22,
      "speech_start": 4.1574583333333335,
      "speech_end": 8.412458333333333,
      "timestamp_anchor_scale": 0.9372216382307752,
      "start_frame": 115,
      "end_frame": 262
    },
    {
      "id": "s03-worm",
      "key": "worm",
      "start": 8.733333333333333,
      "end": 13.3,
      "duration": 4.566666666666668,
      "title": "Putaran masuk dari belakang",
      "text": "Bagian belakang poros berbentuk ulir. Ulir ini meneruskan putaran ke rangkaian roda gigi.",
      "view": "gear",
      "job": "Introduce worm at its functional contact; mark schematic teeth.",
      "word_start": 22,
      "word_end": 35,
      "speech_start": 9.054916666666667,
      "speech_end": 12.969916666666666,
      "timestamp_anchor_scale": 0.9400948957711217,
      "start_frame": 262,
      "end_frame": 399
    },
    {
      "id": "s04-reduction",
      "key": "reduction",
      "start": 13.3,
      "end": 18.166666666666668,
      "duration": 4.866666666666667,
      "title": "Roda gigi meneruskan gerak",
      "text": "Rangkaian itu menggerakkan piringan di bawah rumah roda gigi. Piringan berputar bersama pin di tepinya.",
      "view": "gear",
      "job": "Worm, spindle and carrier disk form a connected power path.",
      "word_start": 35,
      "word_end": 50,
      "speech_start": 13.607375,
      "speech_end": 17.857375,
      "timestamp_anchor_scale": 0.9466028348207894,
      "start_frame": 399,
      "end_frame": 545
    },
    {
      "id": "s05-eccentric",
      "key": "eccentric",
      "start": 18.166666666666668,
      "end": 23.466666666666665,
      "duration": 5.299999999999997,
      "title": "Piringan berputar, pin mengorbit",
      "text": "Perhatikan pin ini. Letaknya menjauh dari pusat, sehingga pin berjalan melingkar ketika piringan berputar.",
      "view": "disc",
      "job": "Crank center versus eccentric pin; no claimed product dimensions.",
      "word_start": 50,
      "word_end": 64,
      "speech_start": 18.484833333333334,
      "speech_end": 23.104833333333332,
      "timestamp_anchor_scale": 0.9616303170506663,
      "start_frame": 545,
      "end_frame": 704
    },
    {
      "id": "s06-rod",
      "key": "rod",
      "start": 23.466666666666665,
      "end": 29.3,
      "duration": 5.833333333333336,
      "title": "Pin membawa batang",
      "text": "Pin tersambung ke batang penghubung. Sambungannya bisa berputar, jadi batang mengikuti perjalanan pin tanpa terlepas.",
      "view": "link",
      "job": "Pin bearing and rigid rod follow one another.",
      "word_start": 64,
      "word_end": 79,
      "speech_start": 23.822541666666666,
      "speech_end": 28.947541666666666,
      "timestamp_anchor_scale": 0.9611359724612732,
      "start_frame": 704,
      "end_frame": 879
    },
    {
      "id": "s07-anchor",
      "key": "anchor",
      "start": 29.3,
      "end": 34.3,
      "duration": 4.9999999999999964,
      "title": "Ujung satunya tertahan",
      "text": "Ujung batang yang lain terpasang pada jangkar di penyangga. Jangkar ini tetap, tidak ikut kepala kipas.",
      "view": "link",
      "job": "Expose stationary anchor A and distinct head pivot O.",
      "word_start": 79,
      "word_end": 95,
      "speech_start": 29.667,
      "speech_end": 33.947,
      "timestamp_anchor_scale": 0.9609475356531304,
      "start_frame": 879,
      "end_frame": 1029
    },
    {
      "id": "s08-constraint",
      "key": "constraint",
      "start": 34.3,
      "end": 40.733333333333334,
      "duration": 6.433333333333337,
      "title": "Jarak ini harus tetap",
      "text": "Inilah kuncinya. Batang tidak memanjang. Saat pin bergerak, rumah roda gigi harus bergeser mengelilingi poros kepala.",
      "view": "macro",
      "job": "Signature: eccentric motion, fixed rod length and yaw response solved together.",
      "word_start": 95,
      "word_end": 111,
      "speech_start": 34.68145833333333,
      "speech_end": 40.44645833333333,
      "timestamp_anchor_scale": 0.9905923169116252,
      "start_frame": 1029,
      "end_frame": 1222
    },
    {
      "id": "s09-push",
      "key": "push",
      "start": 40.733333333333334,
      "end": 46.766666666666666,
      "duration": 6.033333333333331,
      "title": "Kepala terdorong ke satu sisi",
      "text": "Rumah roda gigi terikat pada badan motor. Jadi, ketika mekanisme bergerak, seluruh kepala ikut berayun ke satu sisi.",
      "view": "link",
      "job": "Housing and motor are one rigid moving assembly.",
      "word_start": 111,
      "word_end": 129,
      "speech_start": 41.04891666666666,
      "speech_end": 46.468916666666665,
      "timestamp_anchor_scale": 0.9563466770307034,
      "start_frame": 1222,
      "end_frame": 1403
    },
