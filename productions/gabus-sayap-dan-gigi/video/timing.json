  "scenes": [
    {
      "id": "s01-mystery",
      "key": "mystery",
      "title": "Turun, kok naik?",
      "view": "whole",
      "start": 0,
      "end": 3.466666666666667,
      "duration": 3.466666666666667,
      "text": "Sayapnya ditekan turun. Kenapa gabusnya malah naik?",
      "action": "Opposite wing and cork travel establishes the mystery.",
      "word_start": 0,
      "word_end": 7,
      "speech_start": 0.265,
      "speech_end": 3.175,
      "timestamp_anchor_scale": 1.017375918999806,
      "start_frame": 0,
      "end_frame": 104
    },
    {
      "id": "s02-discover",
      "key": "discover",
      "title": "Gigi mengangkat batang",
      "view": "head",
      "start": 3.466666666666667,
      "end": 7.766666666666667,
      "duration": 4.3,
      "text": "Di pangkal kedua sayap, ada gigi yang berkaitan dengan alur pada batang tengah.",
      "action": "First discovery: toothed sectors drive the annular shaft upward.",
      "word_start": 7,
      "word_end": 20,
      "speech_start": 3.7386041666666667,
      "speech_end": 7.408604166666667,
      "timestamp_anchor_scale": 0.9174038763750654,
      "start_frame": 104,
      "end_frame": 233
    },
    {
      "id": "s03-orient",
      "key": "orient",
      "title": "Satu batang, dua bagian",
      "view": "shaft",
      "start": 7.766666666666667,
      "end": 12.366666666666667,
      "duration": 4.6000000000000005,
      "text": "Batang yang sama punya spiral di bawahnya. Bagian inilah yang menancap ke gabus.",
      "action": "Connect grooved shaft and lower worm, preserving their common axis.",
      "word_start": 20,
      "word_end": 33,
      "speech_start": 8.118416666666667,
      "speech_end": 12.063416666666667,
      "timestamp_anchor_scale": 0.9195772752473508,
      "start_frame": 233,
      "end_frame": 371
    },
    {
      "id": "s04-seat",
      "key": "seat",
      "title": "Badan bertumpu di sini",
      "view": "base",
      "start": 12.366666666666667,
      "end": 17.766666666666666,
      "duration": 5.399999999999999,
      "text": "Mulainya begini. Kaki pembuka duduk di bibir botol, sementara ujung spiral menyentuh gabus.",
      "action": "Base seats on bottle rim and worm approaches cork.",
      "word_start": 33,
      "word_end": 46,
      "speech_start": 12.682020833333333,
      "speech_end": 17.472020833333332,
      "timestamp_anchor_scale": 0.9540833001154106,
      "start_frame": 371,
      "end_frame": 533
    },
    {
      "id": "s05-turn",
      "key": "turn",
      "title": "Putaran masuk ke gabus",
      "view": "worm",
      "start": 17.766666666666666,
      "end": 22.9,
      "duration": 5.133333333333333,
      "text": "Ketika kepala diputar, spiral masuk semakin dalam. Batang tengah ikut bergerak turun.",
      "action": "Rotation and progressive penetration, body and cork stationary.",
      "word_start": 46,
      "word_end": 58,
      "speech_start": 18.068729166666667,
      "speech_end": 22.56372916666667,
      "timestamp_anchor_scale": 0.9431949696596608,
      "start_frame": 533,
      "end_frame": 687
    },
    {
      "id": "s06-grip",
      "key": "grip",
      "title": "Spiral tertanam",
      "view": "cork",
      "start": 22.9,
      "end": 28.533333333333335,
      "duration": 5.633333333333336,
      "text": "Lihat penampangnya. Spiral sudah tertanam di dalam gabus. Sambungan ini nantinya membawa gabus naik.",
      "action": "Cutaway exposes embedded helix and retained cork engagement.",
      "word_start": 58,
      "word_end": 72,
      "speech_start": 23.256645833333334,
      "speech_end": 28.191645833333332,
      "timestamp_anchor_scale": 0.9395124870342286,
      "start_frame": 687,
      "end_frame": 856
    },
    {
      "id": "s07-guide",
      "key": "guide",
      "title": "Turun lewat pemandu",
      "view": "guide",
      "start": 28.533333333333335,
      "end": 34.03333333333333,
      "duration": 5.4999999999999964,
      "text": "Batangnya tetap lewat lubang pemandu di badan alat. Jadi gerak turun ini mencapai bagian bergigi.",
      "action": "Axial shaft motion passes through the stationary guide.",
      "word_start": 72,
      "word_end": 87,
      "speech_start": 28.886458333333334,
      "speech_end": 33.74645833333334,
      "timestamp_anchor_scale": 0.9504106220801578,
      "start_frame": 856,
      "end_frame": 1021
    },
    {
      "id": "s08-rise",
      "key": "rise",
      "title": "Batang turun, sayap naik",
      "view": "head",
      "start": 34.03333333333333,
      "end": 39.6,
      "duration": 5.56666666666667,
      "text": "Alur batang mendorong gigi di kedua sisi. Gigi berputar bersama sayap, mengelilingi porosnya.",
      "action": "Rack descent rotates both sectors and raises both wings.",
      "word_start": 87,
      "word_end": 100,
      "speech_start": 34.32816666666667,
      "speech_end": 39.238166666666665,
      "timestamp_anchor_scale": 0.9473000727743192,
      "start_frame": 1021,
      "end_frame": 1188
    },
    {
      "id": "s09-rings",
      "key": "rings",
      "title": "Alurnya melingkar",
      "view": "rings",
      "start": 39.6,
      "end": 45.53333333333333,
      "duration": 5.93333333333333,
      "text": "Alur di bagian ini melingkari batang, berbeda dari spiral penusuk di bawah. Keduanya punya tugas berbeda.",
      "action": "Annular grooves remain available as shaft rotates; contrast worm pitch.",
      "word_start": 100,
      "word_end": 116,
      "speech_start": 39.9941875,
      "speech_end": 45.1841875,
      "timestamp_anchor_scale": 0.955165604800765,
      "start_frame": 1188,
      "end_frame": 1366
    },
    {
      "id": "s10-pivot",
      "key": "pivot",
      "title": "Porosnya tetap di badan",
      "view": "pin",
      "start": 45.53333333333333,
      "end": 52.5,
      "duration": 6.966666666666669,
      "text": "Sekarang sayap sudah terangkat. Poros masing-masing tetap terpasang pada badan pembuka. Batang tengah masih bisa bergeser.",
      "action": "Fixed pivots and movable shaft establish extraction constraints.",
      "word_start": 116,
      "word_end": 132,
      "speech_start": 45.905208333333334,
      "speech_end": 51.960208333333334,
      "timestamp_anchor_scale": 0.9724190617217463,
      "start_frame": 1366,
      "end_frame": 1575
    },
    {
      "id": "s11-drive",
      "key": "drive",
      "title": "Tekan sayap, balik geraknya",
      "view": "macro",
      "start": 52.5,
      "end": 59.9,
      "duration": 7.399999999999999,
      "text": "Saat sayap ditekan, sektor giginya berputar ke arah sebaliknya. Perhatikan titik pertemuannya: batang terdorong ke atas.",
      "action": "Signature: pitch-coupled contact, sector rotation and shaft rise.",
      "word_start": 132,
      "word_end": 148,
      "speech_start": 53.016041666666666,
      "speech_end": 59.471041666666665,
      "timestamp_anchor_scale": 0.9715277865388247,
      "start_frame": 1575,
      "end_frame": 1797
    },
    {
      "id": "s12-lever",
      "key": "lever",
      "title": "Lengan panjang, sektor pendek",
      "view": "lever",
      "start": 59.9,
      "end": 66.16666666666667,
      "duration": 6.266666666666673,
      "text": "Ujung sayap menjadi tempat menekan. Lengan yang panjang memutar sektor bergigi yang lebih kecil di dekat poros.",
      "action": "Qualitative lever geometry with no numerical mechanical advantage.",
      "word_start": 148,
      "word_end": 165,
      "speech_start": 60.36066666666667,
      "speech_end": 65.72566666666667,
      "timestamp_anchor_scale": 0.9699848450405394,
      "start_frame": 1797,
      "end_frame": 1985
    },
    {
      "id": "s13-reaction",
      "key": "reaction",
      "title": "Tumpuannya tetap di botol",
      "view": "base",
      "start": 66.16666666666667,
      "end": 72.26666666666667,
      "duration": 6.099999999999994,
      "text": "Badan pembuka tetap bertumpu pada bibir botol. Jadi batang bisa naik relatif terhadap botol yang ditahan.",
      "action": "Reaction path from stationary sector support through body and rim.",
      "word_start": 165,
      "word_end": 181,
      "speech_start": 66.5821875,
      "speech_end": 71.9671875,
      "timestamp_anchor_scale": 0.9615063982638633,
      "start_frame": 1985,
      "end_frame": 2168
    },
    {
      "id": "s14-lift",
      "key": "lift",
      "title": "Gabus mengikuti spiral",
      "view": "cork",
      "start": 72.26666666666667,
      "end": 78.33333333333333,
      "duration": 6.066666666666663,
      "text": "Karena spiral masih tertanam, gabus ikut tertarik. Gerak gigi diteruskan sepanjang batang hingga ke gabus.",
      "action": "Embedded worm and cork translate together, no extraction rotation.",
      "word_start": 181,
      "word_end": 196,
      "speech_start": 72.577,
      "speech_end": 78.067,
      "timestamp_anchor_scale": 0.9682267721191502,
      "start_frame": 2168,
      "end_frame": 2350
    },
    {
      "id": "s15-clear",
      "key": "clear",
      "title": "Keluar dari leher botol",
      "view": "whole",
      "start": 78.33333333333333,
      "end": 83.56666666666666,
      "duration": 5.233333333333334,
      "text": "Saat gabus melewati bibir botol, hasil rangkaian gerak tadi terlihat: gabus sudah terangkat.",
      "action": "Cork bottom clears rim; bottle and support remain fixed.",
      "word_start": 196,
      "word_end": 209,
      "speech_start": 78.57370833333333,
      "speech_end": 83.19870833333333,
      "timestamp_anchor_scale": 0.9363015442049889,
      "start_frame": 2350,
      "end_frame": 2507
    },
    {
      "id": "s16-proof",
      "key": "proof",
      "title": "Turun di sini, naik di tengah",
      "view": "proof",
      "start": 83.56666666666666,
      "end": 90,
      "duration": 6.433333333333337,
      "text": "Jadi, sayap turun memutar gigi. Gigi menaikkan batang. Dan spiral membawa gabus keluar.",
      "action": "Matched ending: repeat extraction with section showing all dependencies.",
      "word_start": 209,
      "word_end": 222,
      "speech_start": 83.93472916666667,
      "speech_end": 89.29972916666667,
      "timestamp_anchor_scale": 0.9699848450405419,
      "start_frame": 2507,
      "end_frame": 2700
    }
  ],
