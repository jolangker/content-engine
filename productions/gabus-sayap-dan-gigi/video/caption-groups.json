[
  {
    "start": 0.265,
    "end": 1.61163728,
    "text": "Sayapnya ditekan turun."
  },
  {
    "start": 1.68859076,
    "end": 3.275,
    "text": "Kenapa gabusnya malah naik?"
  },
  {
    "start": 3.73860417,
    "end": 4.88747373,
    "text": "Di pangkal kedua sayap,"
  },
  {
    "start": 4.88747373,
    "end": 5.84486504,
    "text": "ada gigi yang berkaitan"
  },
  {
    "start": 5.84486504,
    "end": 6.80225634,
    "text": "dengan alur pada batang"
  },
  {
    "start": 6.80225634,
    "end": 7.50860417,
    "text": "tengah."
  },
  {
    "start": 8.11841667,
    "end": 9.0780761,
    "text": "Batang yang sama punya"
  },
  {
    "start": 9.0780761,
    "end": 10.25125976,
    "text": "spiral di bawahnya."
  },
  {
    "start": 10.25125976,
    "end": 11.22131551,
    "text": "Bagian inilah yang menancap"
  },
  {
    "start": 11.22131551,
    "end": 12.16341667,
    "text": "ke gabus."
  },
  {
    "start": 12.68202083,
    "end": 13.5889098,
    "text": "Mulainya begini."
  },
  {
    "start": 13.5889098,
    "end": 14.65095726,
    "text": "Kaki pembuka duduk di"
  },
  {
    "start": 14.65095726,
    "end": 16.11127252,
    "text": "bibir botol, sementara ujung"
  },
  {
    "start": 16.11127252,
    "end": 17.572020830000003,
    "text": "spiral menyentuh gabus."
  },
  {
    "start": 18.06872917,
    "end": 19.70924012,
    "text": "Ketika kepala diputar, spiral"
  },
  {
    "start": 19.70924012,
    "end": 20.9125549,
    "text": "masuk semakin dalam."
  },
  {
    "start": 20.9125549,
    "end": 22.03876566,
    "text": "Batang tengah ikut bergerak"
  },
  {
    "start": 22.03876566,
    "end": 22.66372917,
    "text": "turun."
  },
  {
    "start": 23.25664583,
    "end": 24.23710941,
    "text": "Lihat penampangnya."
  },
  {
    "start": 24.23710941,
    "end": 25.31561934,
    "text": "Spiral sudah tertanam di"
  },
  {
    "start": 25.31561934,
    "end": 26.17597613,
    "text": "dalam gabus."
  },
  {
    "start": 26.17597613,
    "end": 27.40727497,
    "text": "Sambungan ini nantinya membawa"
  },
  {
    "start": 27.40727497,
    "end": 28.29164583,
    "text": "gabus naik."
  },
  {
    "start": 28.88645833,
    "end": 30.09897874,
    "text": "Batangnya tetap lewat lubang"
  },
  {
    "start": 30.09897874,
    "end": 31.2668665,
    "text": "pemandu di badan alat."
  },
  {
    "start": 31.2668665,
    "end": 32.39094813,
    "text": "Jadi gerak turun ini"
  },
  {
    "start": 32.39094813,
    "end": 33.846458330000004,
    "text": "mencapai bagian bergigi."
  },
  {
    "start": 34.32816667,
    "end": 35.58038143,
    "text": "Alur batang mendorong gigi"
  },
  {
    "start": 35.58038143,
    "end": 36.56897204,
    "text": "di kedua sisi."
  },
  {
    "start": 36.56897204,
    "end": 38.08481096,
    "text": "Gigi berputar bersama sayap,"
  },
  {
    "start": 38.08481096,
    "end": 39.33816667,
    "text": "mengelilingi porosnya."
  },
  {
    "start": 39.9941875,
    "end": 40.92453321,
    "text": "Alur di bagian ini"
  },
  {
    "start": 40.92453321,
    "end": 42.38650504,
    "text": "melingkari batang, berbeda dari"
  },
  {
    "start": 42.38650504,
    "end": 43.64911708,
    "text": "spiral penusuk di bawah."
  },
  {
    "start": 43.64911708,
    "end": 45.2841875,
    "text": "Keduanya punya tugas berbeda."
  },
  {
    "start": 45.90520833,
    "end": 47.46124185,
    "text": "Sekarang sayap sudah terangkat."
  },
  {
    "start": 47.46124185,
    "end": 48.54369995,
    "text": "Poros masing-masing tetap"
  },
  {
    "start": 48.54369995,
    "end": 50.1673871,
    "text": "terpasang pada badan pembuka."
  },
  {
    "start": 50.1673871,
    "end": 51.2498452,
    "text": "Batang tengah masih bisa"
  },
  {
    "start": 51.2498452,
    "end": 52.06020833,
    "text": "bergeser."
  },
  {
    "start": 53.01604167,
    "end": 54.53685318,
    "text": "Saat sayap ditekan, sektor"
  },
  {
    "start": 54.53685318,
    "end": 55.65211497,
    "text": "giginya berputar ke arah"
  },
  {
    "start": 55.65211497,
    "end": 56.46321444,
    "text": "sebaliknya."
  },
  {
    "start": 56.46321444,
    "end": 57.95023015,
    "text": "Perhatikan titik pertemuannya:"
  },
  {
    "start": 57.95023015,
    "end": 58.92892125,
    "text": "batang terdorong ke"
  },
  {
    "start": 59.13308355,
    "end": 59.57104167,
    "text": "atas."
  },
  {
    "start": 60.36066667,
    "end": 61.57538365,
    "text": "Ujung sayap menjadi tempat"
  },
  {
    "start": 61.57538365,
    "end": 62.25022642,
    "text": "menekan."
  },
  {
    "start": 62.25022642,
    "end": 63.4649434,
    "text": "Lengan yang panjang memutar"
  },
  {
    "start": 63.4649434,
    "end": 64.47720755,
    "text": "sektor bergigi yang lebih"
  },
  {
    "start": 64.47720755,
    "end": 65.82566666999999,
    "text": "kecil di dekat poros."
  },
  {
    "start": 66.5821875,
    "end": 67.9535229,
    "text": "Badan pembuka tetap bertumpu"
  },
  {
    "start": 67.9535229,
    "end": 68.99038626,
    "text": "pada bibir botol."
  },
  {
    "start": 68.99038626,
    "end": 70.12759123,
    "text": "Jadi batang bisa naik"
  },
  {
    "start": 70.12759123,
    "end": 71.3647962,
    "text": "relatif terhadap botol yang"
  },
  {
    "start": 71.36513781,
    "end": 72.06718749999999,
    "text": "ditahan."
  },
  {
    "start": 72.577,
    "end": 74.05896319,
    "text": "Karena spiral masih tertanam,"
  },
  {
    "start": 74.05896319,
    "end": 75.27147853,
    "text": "gabus ikut tertarik."
  },
  {
    "start": 75.27147853,
    "end": 76.68607975,
    "text": "Gerak gigi diteruskan sepanjang"
  },
  {
    "start": 76.68607975,
    "end": 78.16699999999999,
    "text": "batang hingga ke gabus."
  },
  {
    "start": 78.57370833,
    "end": 79.78110269999999,
    "text": "Saat gabus melewati bibir"
  },
  {
    "start": 79.81138439,
    "end": 81.14677171,
    "text": "botol, hasil rangkaian gerak"
  },
  {
    "start": 81.14677171,
    "end": 82.54729988,
    "text": "tadi terlihat: gabus sudah"
  },
  {
    "start": 82.54729988,
    "end": 83.29870833,
    "text": "terangkat."
  },
  {
    "start": 83.93472917,
    "end": 85.48686753,
    "text": "Jadi, sayap turun memutar"
  },
  {
    "start": 85.48686753,
    "end": 86.12796816,
    "text": "gigi."
  },
  {
    "start": 86.12796816,
    "end": 87.41016942,
    "text": "Gigi menaikkan batang."
  },
  {
    "start": 87.41016942,
    "end": 88.69237068,
    "text": "Dan spiral membawa gabus"
  },
  {
    "start": 88.69237068,
    "end": 89.39972917,
    "text": "keluar."
  }
]
